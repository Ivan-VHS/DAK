{
  "schema": "mora.theme.v1",
  "name": "DuckOS Black White Yellow",
  "version": 4,
  "palettes": {
    "duck": {
      "page": "#080808",
      "surface": "#151515",
      "elevated": "#242424",
      "text": "#FFFFFF",
      "secondary": "#E5E5E5",
      "muted": "#A6A6A6",
      "brand": "#FFD400",
      "brandHover": "#FFE45C",
      "onBrand": "#080808",
      "secondaryAccent": "#FFD400",
      "onSecondaryAccent": "#080808",
      "border": "#3A3A3A",
      "selection": "#3A3100",
      "danger": "#FFD400",
      "onDanger": "#080808"
    }
  },
  "shape": {
    "windowRadius": 22,
    "cardRadius": 16,
    "controlRadius": 10
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32
  ],
  "interaction": {
    "minimumTargetPx": 44,
    "focusRingPx": 2
  },
  "motion": {
    "fastMs": 140,
    "standardMs": 180,
    "spatialMs": 220,
    "reduceMotionMaxMs": 80,
    "ecoVisualsMaxMs": 80
  },
  "typography": {
    "ui": "Segoe UI",
    "display": "Unbounded",
    "code": "Cascadia Mono"
  },
  "defaultPalette": "duck",
  "materials": {
    "glass": {
      "progressiveEnhancement": true,
      "fallback": "#151515",
      "strongFallback": "#080808",
      "fillOpacity": 0.78,
      "strongFillOpacity": 0.84,
      "blurPx": 18,
      "strongBlurPx": 22,
      "mobileBlurPx": 10,
      "mobileStrongBlurPx": 14,
      "edge": "rgba(255,212,0,0.26)",
      "maxConcurrentBlurLayers": 5,
      "reducedTransparency": "opaque",
      "forcedColors": "system",
      "nativeBackdrops": {
        "windows": {
          "api": "DwmSetWindowAttribute",
          "attribute": 38,
          "mainWindowType": 2,
          "requiresSystemBackdropSupport": true,
          "fallback": "opaque"
        },
        "otherPlatforms": "opaque"
      },
      "blurSurfaces": [
        "statusbar",
        "widget-card",
        "dock",
        "app-window",
        "toast"
      ],
      "performance": {
        "maxConcurrentBlurLayers": 5,
        "mobileBlurReductionPercent": 44,
        "opaqueFallbackRequired": true,
        "animateBackdropFilter": false
      }
    }
  },
  "ergonomics": {
    "skipLink": true,
    "focusVisibleOutlinePx": 3,
    "minimumPointerTargetPx": 44,
    "densityModes": [
      "comfortable",
      "compact"
    ],
    "defaultDensity": "comfortable",
    "keyboardWindowMovement": {
      "keys": [
        "ArrowUp",
        "ArrowDown",
        "ArrowLeft",
        "ArrowRight"
      ],
      "stepPx": 16,
      "acceleratedStepPx": 48
    },
    "shortcuts": {
      "openControl": "Ctrl+,",
      "openMoraAI": "Ctrl+K",
      "closeTopWindow": "Escape"
    },
    "restoreFocusOnClose": true,
    "avoidDragOnlyInteraction": true
  }
}
