{
  "schema": "mora.theme.v1",
  "name": "DuckOS Imperial Noir & Glass",
  "version": 4,
  "palettes": {
    "duck": {
      "page": "#050505",
      "surface": "#101010",
      "elevated": "#181818",
      "text": "#FFFFFF",
      "secondary": "#E5E5E5",
      "muted": "#A6A6A6",
      "brand": "#FFD700",
      "brandHover": "#FFE45C",
      "onBrand": "#080808",
      "secondaryAccent": "#FFD700",
      "onSecondaryAccent": "#080808",
      "border": "#3A3A3A",
      "selection": "#3A3100",
      "danger": "#C43A45",
      "onDanger": "#FFFFFF",
      "statusSuccess": "#2EAD68",
      "statusWarning": "#FFD700",
      "statusError": "#FF6B72",
      "statusInfo": "#6CA8FF"
    }
  },
  "shape": {
    "windowRadius": 8,
    "cardRadius": 8,
    "controlRadius": 6
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32
  ],
  "interaction": {
    "minimumTargetPx": 44,
    "focusRingPx": 2
  },
  "motion": {
    "fastMs": 140,
    "standardMs": 180,
    "spatialMs": 220,
    "reduceMotionMaxMs": 80,
    "ecoVisualsMaxMs": 80,
    "microMs": 100,
    "emphasisMs": 280,
    "maxDurationMs": 280,
    "springCurve": "cubic-bezier(0.34, 1.12, 0.64, 1)",
    "strictCurve": "cubic-bezier(0.65, 0, 0.35, 1)"
  },
  "typography": {
    "ui": "Segoe UI",
    "display": "Unbounded",
    "code": "Cascadia Mono"
  },
  "defaultPalette": "duck",
  "glass": {
    "surface": "rgba(7,7,7,0.78)",
    "strongSurface": "rgba(7,7,7,0.86)",
    "border": "rgba(255,255,255,0.16)",
    "activeBorder": "#FFD700",
    "fallback": "#101010",
    "strongFallback": "#070707",
    "blurPx": 18,
    "strongBlurPx": 22,
    "grainOpacity": 0.035,
    "maxConcurrentBlurLayers": 5,
    "maxNestedLevels": 2,
    "mobileBlurScale": 0.55,
    "ecoBlurScale": 0.5,
    "reducedTransparency": "opaque",
    "animateBackdrop": false,
    "noiseAsset": "./glass-noise.svg"
  }
}
