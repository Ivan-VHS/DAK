{
  "schema": "mora.theme.v1",
  "name": "DuckOS Black White Yellow",
  "version": 2,
  "palettes": {
    "duck": {
      "page": "#080808",
      "surface": "#151515",
      "elevated": "#242424",
      "text": "#FFFFFF",
      "secondary": "#E5E5E5",
      "muted": "#A6A6A6",
      "brand": "#FFD400",
      "brandHover": "#FFE45C",
      "onBrand": "#080808",
      "secondaryAccent": "#FFD400",
      "onSecondaryAccent": "#080808",
      "border": "#3A3A3A",
      "selection": "#3A3100",
      "danger": "#FFD400",
      "onDanger": "#080808"
    }
  },
  "shape": {
    "windowRadius": 22,
    "cardRadius": 16,
    "controlRadius": 10
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32
  ],
  "interaction": {
    "minimumTargetPx": 44,
    "focusRingPx": 2
  },
  "motion": {
    "fastMs": 140,
    "standardMs": 180,
    "spatialMs": 220,
    "reduceMotionMaxMs": 80,
    "ecoVisualsMaxMs": 80
  },
  "typography": {
    "ui": "Segoe UI",
    "display": "Unbounded",
    "code": "Cascadia Mono"
  },
  "defaultPalette": "duck",
  "materials": {
    "industrialGlass": {
      "role": "overlay-panel",
      "surface": "#171717",
      "opacityPercent": 88,
      "blurRadiusPx": 18,
      "border": "rgba(255,255,255,0.12)",
      "shadow": "rgba(0,0,0,0.36)",
      "fallback": "opaque-surface",
      "reducedMotion": "disable-blur-and-transitions"
    },
    "acrylic": {
      "role": "secondary-surface",
      "surface": "#242424",
      "opacityPercent": 94,
      "border": "#3A3A3A",
      "fallback": "opaque-surface"
    },
    "matte": {
      "role": "content-surface",
      "surface": "#151515",
      "opacityPercent": 100
    }
  },
  "states": {
    "default": {
      "surface": "#151515",
      "text": "#FFFFFF",
      "border": "#3A3A3A"
    },
    "hover": {
      "surface": "#222016",
      "text": "#FFFFFF",
      "border": "#FFD400"
    },
    "focus": {
      "surface": "#151515",
      "text": "#FFFFFF",
      "outline": "#FFE45C",
      "outlineWidthPx": 2
    },
    "selected": {
      "surface": "#3A3100",
      "text": "#FFFFFF",
      "border": "#FFD400"
    },
    "disabled": {
      "surface": "#171717",
      "text": "#777777",
      "border": "#303030"
    },
    "success": {
      "marker": "#22C55E",
      "requiresText": true
    },
    "warning": {
      "marker": "#EAB308",
      "requiresText": true
    },
    "critical": {
      "marker": "#EF4444",
      "requiresText": true
    }
  },
  "iconography": {
    "family": "Duck Glyph System",
    "canonicalGridPx": 24,
    "minimumVisibleSizePx": 16,
    "minimumInteractiveTargetPx": 44,
    "requireAccessibleName": true,
    "noColorOnlyMeaning": true
  },
  "appearance": {
    "systemPalette": "duck",
    "wallpaperCatalog": "mora/wallpapers/catalog.json",
    "wallpaperSelection": "independent-from-system-palette",
    "localOnly": true
  }
}
