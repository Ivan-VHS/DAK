        "bela-notes",
        "rina-craft",
        "olea-kitchen",
        "veda-bloom",
        "mila-nest",
        "daria-ledger",
        "elda-circle"
      ],
      "data_policy": "local_only",
      "maturity_status": "partial",
      "storage_key": "mora.personal-suite.v1",
      "cloud_sync": false
    }
  ]
}
