      "app_id": "unify",
      "kind": "device_status"
    }
  ],
  "integration": {
    "manifest_schema": "mora/app-manifest.schema.json",
    "external_launch": "specified_not_enabled",
    "execution_rule": "A future native launcher must resolve trusted installed paths and require explicit operator approval. Never execute manifest commands through a shell."
  },
  "system_services": [
    {
      "id": "intent-planner",
      "maturity": "partial",
      "scope": "whitelisted local actions; approval required"
    },
    {
      "id": "capability-broker",
      "maturity": "specified",
      "scope": "UI preferences only; no process enforcement"
    },
    {
      "id": "atomic-updater",
      "maturity": "planned",
      "scope": "no native updater or OS images connected"
    },
    {
      "id": "compat-runtime",
      "maturity": "partial",
      "scope": "PE32/PE32+ headers, sections and import DLL inspection; isolated prefix scaffold and CLI diagnostics; no native process execution"
    },
    {
      "id": "provenance-verifier",
      "maturity": "partial",
      "scope": "local SHA-256 only; no C2PA validation"
    },
    {
      "id": "resource-scheduler",
      "maturity": "planned",
      "scope": "no kernel or device scheduling integration"
    },
    {
      "id": "pwa-shell",
      "maturity": "partial",
      "scope": "scoped offline cache for Mora web assets; no OS installation"
    },
    {
      "id": "theme-adapter",
      "maturity": "implemented",
      "scope": "shared dark/light semantic tokens in Mora shell"
    },
    {
      "id": "extension-local-store",
      "maturity": "partial",
      "scope": "Namespaced local browser collections for the extended Mora panels; no system VFS or cross-device synchronization."
    },
    {
      "id": "browser-file-inspector",
      "maturity": "partial",
      "scope": "User-selected archive metadata and PE/ELF inspection in the browser; no extraction or executable launch."
    },
    {
      "id": "rhythm-profile-store",
      "maturity": "partial",
      "scope": "Local BPM and swing profiles only; no audio engine or device routing."
    },
    {
      "id": "setup-preferences",
      "maturity": "partial",
      "scope": "Mora first-run preferences only; no OS installer or boot configuration."
    },
    {
      "id": "desktop-optimizer",
      "maturity": "partial_native_userland",
      "scope": "read-only local desktop/process audit, reversible current-user startup controls, confirmed move-to-Inbox operation and native Tk maintenance window; no compositor or kernel enforcement"
    }
  ]
}
