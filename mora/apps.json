{
  "schema_version": "1.1.0",
  "shell": {
    "id": "ivan-vhs.duckos.mora",
    "name": "Mora",
    "data_policy": "local_service_data_with_attributed_news_and_fictional_demo_content"
  },
  "built_in_apps": [
    {
      "id": "cockos",
      "name": "Cockos",
      "category": "audio",
      "panel": "mora/app.js#cockos"
    },
    {
      "id": "kavun",
      "name": "Kavun",
      "category": "photos",
      "panel": "mora/app.js#kavun"
    },
    {
      "id": "kabon",
      "name": "Ka-bon",
      "category": "finance",
      "panel": "mora/app.js#kabon"
    },
    {
      "id": "gloverty",
      "name": "Gloverty",
      "category": "automation",
      "panel": "mora/app.js#gloverty"
    },
    {
      "id": "po",
      "name": "Po",
      "category": "compass",
      "panel": "mora/app.js#po"
    },
    {
      "id": "illidia",
      "name": "Illidia",
      "category": "games",
      "panel": "mora/app.js#illidia"
    },
    {
      "id": "unify",
      "name": "Unify",
      "category": "devices",
      "panel": "mora/app.js#unify"
    },
    {
      "id": "mora-ai",
      "name": "Mora AI",
      "category": "system",
      "panel": "mora/app.js#mora-ai",
      "maturity": "partial_local_rules"
    },
    {
      "id": "security",
      "name": "Sentinel",
      "category": "security",
      "panel": "mora/app.js#security",
      "maturity": "shell_policy_only"
    },
    {
      "id": "updates",
      "name": "Restore",
      "category": "recovery",
      "panel": "mora/app.js#updates",
      "maturity": "shell_snapshot_only"
    },
    {
      "id": "runtime",
      "name": "Bridge",
      "category": "compatibility",
      "panel": "mora/app.js#runtime",
      "maturity": "header_inspection_plus_wine_os_run_cli"
    },
    {
      "id": "workspace",
      "name": "Control",
      "category": "workspace",
      "panel": "mora/app.js#workspace",
      "maturity": "shell_preferences"
    },
    {
      "id": "provenance",
      "name": "Proof",
      "category": "provenance",
      "panel": "mora/app.js#provenance",
      "maturity": "sha256_only"
    },
    {
      "id": "newsroom",
      "name": "Вечерний курьер",
      "category": "news",
      "panel": "mora/app.js#newsroom",
      "maturity": "local_rss_service"
    },
    {
      "id": "horizon",
      "name": "Horizon",
      "category": "system",
      "panel": "mora/app.js#horizon",
      "maturity": "feature_status_dashboard"
    }
  ],
  "widgets": [
    {
      "id": "kabon.expenses_today",
      "app_id": "kabon",
      "kind": "expenses_summary"
    },
    {
      "id": "unify.device_status",
      "app_id": "unify",
      "kind": "device_status"
    }
  ],
  "integration": {
    "manifest_schema": "mora/app-manifest.schema.json",
    "external_launch": "specified_not_enabled",
    "execution_rule": "A future native launcher must resolve trusted installed paths and require explicit operator approval. Never execute manifest commands through a shell."
  },
  "system_services": [
    {
      "id": "intent-planner",
      "maturity": "partial",
      "scope": "whitelisted local actions; approval required"
    },
    {
      "id": "capability-broker",
      "maturity": "specified",
      "scope": "UI preferences only; no process enforcement"
    },
    {
      "id": "atomic-updater",
      "maturity": "planned",
      "scope": "no native updater or OS images connected"
    },
    {
      "id": "compat-runtime",
      "maturity": "partial",
      "scope": "PE/ELF inspection plus Wine-backed argv os-run CLI on supported POSIX hosts; no Win32 kernel or bundled graphics translation"
    },
    {
      "id": "provenance-verifier",
      "maturity": "partial",
      "scope": "local SHA-256 only; no C2PA validation"
    },
    {
      "id": "resource-scheduler",
      "maturity": "planned",
      "scope": "no kernel or device scheduling integration"
    },
    {
      "id": "pwa-shell",
      "maturity": "partial",
      "scope": "scoped offline cache for Mora web assets; no OS installation"
    },
    {
      "id": "theme-adapter",
      "maturity": "implemented",
      "scope": "shared dark/light semantic tokens in Mora shell"
    },
    {
      "id": "newsroom-feed",
      "maturity": "implemented",
      "scope": "fixed HTTPS RSS/Atom publishers through loopback API; attribution preserved"
    }
  ]
}
