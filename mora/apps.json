{
  "schema_version": "1.1.0",
  "shell": {
    "id": "ivan-vhs.duckos.mora",
    "name": "Mora",
    "data_policy": "local_browser_data; explicitly labeled illustrative dashboard values; no connected cloud synchronization"
  },
  "built_in_apps": [
    {
      "id": "cockos",
      "name": "Cockos",
      "category": "audio",
      "panel": "mora/app.js#cockos"
    },
    {
      "id": "kavun",
      "name": "Kavun",
      "category": "photos",
      "panel": "mora/app.js#kavun"
    },
    {
      "id": "kabon",
      "name": "Ka-bon",
      "category": "finance",
      "panel": "mora/app.js#kabon"
    },
    {
      "id": "gloverty",
      "name": "Gloverty",
      "category": "automation",
      "panel": "mora/app.js#gloverty"
    },
    {
      "id": "po",
      "name": "Po",
      "category": "compass",
      "panel": "mora/app.js#po"
    },
    {
      "id": "illidia",
      "name": "Illidia",
      "category": "games",
      "panel": "mora/app.js#illidia"
    },
    {
      "id": "unify",
      "name": "Unify",
      "category": "devices",
      "panel": "mora/app.js#unify"
    },
    {
      "id": "mora-ai",
      "name": "Mora AI",
      "category": "system",
      "panel": "mora/app.js#mora-ai",
      "maturity": "partial_local_rules"
    },
    {
      "id": "security",
      "name": "Sentinel",
      "category": "security",
      "panel": "mora/app.js#security",
      "maturity": "shell_policy_only"
    },
    {
      "id": "updates",
      "name": "Restore",
      "category": "recovery",
      "panel": "mora/app.js#updates",
      "maturity": "shell_snapshot_only"
    },
    {
      "id": "runtime",
      "name": "Bridge",
      "category": "compatibility",
      "panel": "mora/app.js#runtime",
      "maturity": "header_inspection_only"
    },
    {
      "id": "workspace",
      "name": "Control",
      "category": "workspace",
      "panel": "mora/app.js#workspace",
      "maturity": "shell_preferences"
    },
    {
      "id": "provenance",
      "name": "Proof",
      "category": "provenance",
      "panel": "mora/app.js#provenance",
      "maturity": "sha256_only"
    }
  ],
  "widgets": [
    {
      "id": "kabon.expenses_today",
      "app_id": "kabon",
      "kind": "expenses_summary"
    },
    {
      "id": "unify.device_status",
      "app_id": "unify",
      "kind": "device_status"
    }
  ],
  "integration": {
    "manifest_schema": "mora/app-manifest.schema.json",
    "external_launch": "implemented_loopback_allowlist_launcher",
    "execution_rule": "The browser submits only a registered app ID. The loopback host selects a fixed, reviewed entry point. Manifest strings are descriptive metadata and are never executed."
  },
  "system_services": [
    {
      "id": "intent-planner",
      "maturity": "partial",
      "scope": "whitelisted local actions; approval required"
    },
    {
      "id": "capability-broker",
      "maturity": "specified",
      "scope": "UI preferences only; no process enforcement"
    },
    {
      "id": "atomic-updater",
      "maturity": "planned",
      "scope": "no native updater or OS images connected"
    },
    {
      "id": "compat-runtime",
      "maturity": "partial",
      "scope": "PE and ELF header inspection; no process execution"
    },
    {
      "id": "provenance-verifier",
      "maturity": "partial",
      "scope": "local SHA-256 only; no C2PA validation"
    },
    {
      "id": "resource-scheduler",
      "maturity": "planned",
      "scope": "no kernel or device scheduling integration"
    },
    {
      "id": "pwa-shell",
      "maturity": "partial",
      "scope": "scoped offline cache for Mora web assets; no OS installation"
    },
    {
      "id": "theme-adapter",
      "maturity": "implemented",
      "scope": "shared dark/light semantic tokens in Mora shell"
    }
  ],
  "native_apps": [
    {
      "id": "reaper",
      "name": "Reaper Studio",
      "category": "developer",
      "repository": "https://github.com/Ivan-VHS/Reaper",
      "entrypoint": "reaper_desktop.py",
      "platforms": [
        "windows",
        "linux",
        "macos"
      ],
      "launch": "allowlisted_local_process"
    },
    {
      "id": "oplague",
      "name": "OPlague",
      "category": "system",
      "repository": "https://github.com/Ivan-VHS/OPlague",
      "entrypoint": "oplague_app.py",
      "platforms": [
        "windows",
        "linux",
        "macos"
      ],
      "launch": "allowlisted_local_process"
    },
    {
      "id": "ventusample",
      "name": "VentuSample",
      "category": "audio",
      "repository": "https://github.com/Ivan-VHS/VentuSample",
      "entrypoint": "CMake target VentuSample",
      "platforms": [
        "windows",
        "linux",
        "macos"
      ],
      "launch": "built_native_target"
    },
    {
      "id": "pytyliki",
      "name": "Pytyliki",
      "category": "compute",
      "repository": "https://github.com/Ivan-VHS/Pytyliki",
      "entrypoint": "pytyliki-gui.exe",
      "platforms": [
        "windows"
      ],
      "launch": "built_native_target"
    }
  ]
}
