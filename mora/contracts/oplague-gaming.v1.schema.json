{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mora.oplague.gaming.v1",
  "title": "Mora to OPlague Gaming Capability Contract",
  "description": "Permission-scoped messages for a future authenticated native DuckOS host bridge. This schema does not itself provide a bridge.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "protocol",
        "kind",
        "request_id",
        "nonce",
        "issued_at",
        "expires_at",
        "capability",
        "consent",
        "payload"
      ],
      "properties": {
        "protocol": {
          "const": "mora.oplague.gaming.v1"
        },
        "kind": {
          "const": "request"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "nonce": {
          "type": "string",
          "minLength": 24,
          "maxLength": 256
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "capability": {
          "type": "string",
          "enum": [
            "hardware.read",
            "snapshot.create",
            "session.start",
            "session.restore",
            "benchmark.compare",
            "profile.read",
            "profile.write.validated"
          ]
        },
        "consent": {
          "type": "object",
          "required": [
            "granted",
            "scope"
          ],
          "properties": {
            "granted": {
              "const": true
            },
            "scope": {
              "type": "string",
              "enum": [
                "hardware.read",
                "snapshot.create",
                "power-plan.temporary",
                "benchmark.read",
                "profile.read",
                "profile.write.validated"
              ]
            }
          },
          "additionalProperties": false
        },
        "payload": {
          "type": "object",
          "properties": {
            "game_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "game_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "power_mode": {
              "type": "string",
              "enum": [
                "performance",
                "balanced",
                "none"
              ]
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "baseline_report_id": {
              "type": "string",
              "format": "uuid"
            },
            "candidate_report_id": {
              "type": "string",
              "format": "uuid"
            },
            "hardware_fingerprint": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            },
            "driver_version": {
              "type": "string",
              "maxLength": 128
            },
            "settings": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "competitive",
                    "balanced",
                    "quality"
                  ]
                },
                "resolution": {
                  "type": "string",
                  "maxLength": 32
                },
                "refresh_hz": {
                  "type": "integer",
                  "minimum": 24,
                  "maximum": 1000
                },
                "frame_cap": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "graphics_preset": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "ultra",
                    "custom"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capability": {
                "const": "session.start"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "required": [
                  "game_name",
                  "power_mode"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "session.restore"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "required": [
                  "session_id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "benchmark.compare"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "required": [
                  "baseline_report_id",
                  "candidate_report_id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "profile.write.validated"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "required": [
                  "game_id",
                  "game_name",
                  "hardware_fingerprint",
                  "driver_version",
                  "settings"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "hardware.read"
              }
            }
          },
          "then": {
            "properties": {
              "consent": {
                "properties": {
                  "scope": {
                    "const": "hardware.read"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "snapshot.create"
              }
            }
          },
          "then": {
            "properties": {
              "consent": {
                "properties": {
                  "scope": {
                    "const": "snapshot.create"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "enum": [
                  "session.start",
                  "session.restore"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "consent": {
                "properties": {
                  "scope": {
                    "const": "power-plan.temporary"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "benchmark.compare"
              }
            }
          },
          "then": {
            "properties": {
              "consent": {
                "properties": {
                  "scope": {
                    "const": "benchmark.read"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "profile.read"
              }
            }
          },
          "then": {
            "properties": {
              "consent": {
                "properties": {
                  "scope": {
                    "const": "profile.read"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "profile.write.validated"
              }
            }
          },
          "then": {
            "properties": {
              "consent": {
                "properties": {
                  "scope": {
                    "const": "profile.write.validated"
                  }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": [
        "protocol",
        "kind",
        "request_id",
        "completed_at",
        "status",
        "result"
      ],
      "properties": {
        "protocol": {
          "const": "mora.oplague.gaming.v1"
        },
        "kind": {
          "const": "response"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "denied",
            "unsupported",
            "failed",
            "needs_confirmation"
          ]
        },
        "result": {
          "type": "object"
        },
        "error_code": {
          "type": "string",
          "maxLength": 96
        },
        "message": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object"
}
