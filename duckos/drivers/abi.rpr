# Driver descriptor: [id, abi_version, bus, required_capabilities].
# Validation does not load or execute a driver.

export craft descriptor_valid(descriptor, expected_abi, supported_buses) {
    when size(descriptor) != 4 {
        yield false
    }
    when descriptor[0] == "" or descriptor[1] != expected_abi or descriptor[2] == "" {
        yield false
    }

    vary supported := false
    each bus in supported_buses {
        when bus == descriptor[2] {
            change supported := true
        }
    }
    yield supported
}

export craft load_policy(descriptor, expected_abi, supported_buses, granted_capabilities) {
    when not descriptor_valid(descriptor, expected_abi, supported_buses) {
        yield "reject"
    }

    vary allowed := true
    each requested in descriptor[3] {
        vary present := false
        each granted in granted_capabilities {
            when granted == requested {
                change present := true
            }
        }
        when not present {
            change allowed := false
        }
    }

    when not allowed {
        yield "reject"
    }
    yield "descriptor-approved"
}


# Read-only security sensor driver approval.
# sensor: [id, abi, bus, arch, required_capabilities, publisher_id, image_digest].
# The verifier supplies these result flags after checking its trusted key store.
# This function is policy only; it does not load or map driver code.
export craft security_sensor_policy(
    sensor,
    expected_abi,
    supported_buses,
    target_arch,
    grants,
    signature_verified,
    signer_trusted,
    not_revoked,
    digest_matches,
    secure_boot_verified
) {
    when size(sensor) != 7 {
        yield "reject"
    }
    when sensor[0] == "" or sensor[3] != target_arch or sensor[5] == "" or sensor[6] == "" {
        yield "reject"
    }
    when signature_verified != true or signer_trusted != true or not_revoked != true or digest_matches != true or secure_boot_verified != true {
        yield "reject"
    }
    make descriptor := [sensor[0], sensor[1], sensor[2], sensor[4]]
    when load_policy(descriptor, expected_abi, supported_buses, grants) != "descriptor-approved" {
        yield "reject"
    }
    yield "security-sensor-approved"
}
