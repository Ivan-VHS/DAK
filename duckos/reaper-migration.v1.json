{
  "schema": "duckos.reaper-migration.v1",
  "version": 1,
  "project": "DuckOS",
  "migration_goal": "Move executable OS, kernel, driver, service and user-space system logic to Reaper while retaining only reviewed architecture bootstrap and foreign-runtime boundaries.",
  "maturity": "contract-first",
  "reaper_dependency": {
    "repository": "Ivan-VHS/Reaper",
    "url": "https://github.com/Ivan-VHS/Reaper.git",
    "submodule_path": "projects/reaper",
    "pinned_commit": "cd84d347959f9b6cf60d87ab3d36bc94e05fd80f",
    "source_of_pin": "federation/repositories.v1.json",
    "required_entrypoints": [
      "--check",
      "--engine vm"
    ],
    "runtime_status": "reference-runtime-and-vm",
    "native_aot_status": "experimental-scalar-subset"
  },
  "boot_target": {
    "architecture": null,
    "boot_protocol": null,
    "kernel_abi": null,
    "decision_status": "undecided",
    "boot_info_contract": "C11 host-tested duckos.boot-info.v1",
    "bootable_image": false,
    "reason": "Architecture, boot protocol, memory map and kernel ABI require an approved ADR and native bring-up evidence."
  },
  "execution_profiles": {
    "reaper_reference_contract": {
      "status": "implemented",
      "execution": [
        "tree-walk",
        "vm"
      ],
      "scope": "Policy and deterministic contract logic in duckos/**/*.rpr; this is not privileged hardware execution."
    },
    "reaper_native_kernel": {
      "status": "planned",
      "freestanding": false,
      "object_backend": false,
      "linker_integration": false,
      "startup_runtime": false,
      "bootable": false,
      "blockers": [
        "native lowering for lists, indexing, each, imports and collection pipelines",
        "fixed-width integer and pointer types with target-aware layouts",
        "aggregate ABI, alignment and packed-layout rules",
        "freestanding runtime, panic, allocator and no-host-library profiles",
        "ownership, lifetime, unsafe and effect/capability checking",
        "volatile MMIO, atomics, barriers, DMA and interrupt contracts",
        "architecture intrinsics, assembly entry points and context switching",
        "object emission, relocations, linker scripts and debug information",
        "cross-target differential tests and emulator boot qualification"
      ]
    }
  },
