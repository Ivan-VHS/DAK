# DuckOS predictive-security policy contracts.
import "decision.rpr" as decision
import "../services/security.rpr" as security_service

assert(decision["risk_score"](0, 0, false, false, false, false) == 0, "benign activity has no added risk")
assert(decision["risk_score"](5, 0.8, true, true, true, false) == 100, "correlated destructive activity saturates risk")
assert(decision["risk_score"](-1, 0, false, false, false, false) == -1, "invalid input is rejected")
assert(decision["action_for"](15) == "monitor", "low risk remains observable")
assert(decision["action_for"](25) == "sandbox", "medium risk requests containment review")
assert(decision["action_for"](45) == "restrict", "high risk restricts through the policy boundary")
assert(decision["action_for"](65) == "isolate", "very high risk recommends isolation")
assert(decision["action_for"](90) == "block", "critical risk recommends blocking")
assert(decision["snapshot_required"](true, 0), "destructive operations require a pre-action snapshot")
assert(not decision["snapshot_required"](false, 10), "ordinary activity does not require a snapshot")
assert(decision["mesh_signal_allowed"](true, true, false), "authenticated fresh unique mesh signals are accepted")
assert(not decision["mesh_signal_allowed"](false, true, false), "unsigned mesh signals are rejected")
assert(not decision["mesh_signal_allowed"](true, false, false), "expired mesh signals are rejected")
assert(not decision["mesh_signal_allowed"](true, true, true), "replayed mesh signals are rejected")
assert(decision["recovery_allowed"](true, true, true), "recovery requires an authenticated verified snapshot and authorized target")
assert(not decision["recovery_allowed"](true, false, true), "unverified recovery material is rejected")
assert(decision["resource_profile"](true, false, false) == "quiet", "fullscreen mode may defer deep scans")
assert(decision["resource_profile"](false, false, true) == "security_critical", "suspicious activity overrides comfort profiles")


# OS service lifecycle, trust and dangerous-action authorization.
make security_descriptor := security_service["descriptor"]()
assert(security_descriptor[0] == "duckos.security", "security service is registered by stable system identity")
assert(security_descriptor[2] == "services", "security service starts in the services boot phase")
assert(security_service["start_allowed"]("services", true, true, true), "security service starts after all required dependencies")
assert(not security_service["start_allowed"]("desktop", true, true, true), "security service rejects out-of-order startup")
assert(security_service["health_state"](4, 16, 0, true, true) == "healthy", "healthy event queue")
assert(security_service["health_state"](16, 16, 0, true, true) == "backpressured", "full event queue reports pressure")
assert(security_service["health_state"](0, 16, 0, false, true) == "degraded", "missing policy keeps service degraded")
assert(security_service["authorize_action"]("observe", "trusted", ["security.events.read"], true, true, false, false, false, false), "trusted observers may read security evidence")
assert(not security_service["authorize_action"]("observe", "untrusted", ["security.events.read"], true, true, false, false, false, false), "untrusted callers are denied")
assert(not security_service["authorize_action"]("process.terminate", "trusted", ["security.process.terminate"], true, true, false, false, false, false), "destructive actions require explicit approval")
assert(security_service["authorize_action"]("process.terminate", "trusted", ["security.process.terminate"], true, true, true, false, false, false), "approved destructive action passes kernel policy gate")
assert(not security_service["authorize_action"]("process.terminate", "trusted", ["security.events.read"], true, true, true, false, false, false), "read capability cannot authorize process termination")
assert(not security_service["authorize_action"]("file.restore", "trusted", ["security.file.restore"], true, true, true, false, true, true), "unverified snapshots cannot authorize recovery")
assert(security_service["authorize_action"]("file.restore", "trusted", ["security.file.restore"], true, true, true, true, true, true), "authenticated verified snapshots may be restored to an authorized target")
assert(not security_service["authorize_action"]("file.restore", "trusted", ["security.file.restore"], true, false, true, true, true, true), "invalid policy cannot authorize recovery")
assert(security_service["restart_decision"](1, 1, 3) == ["restart", 2], "service restart reuses the bounded system supervisor")


make sensor_bundle := capabilities["security_sensor_grants"]()
make service_bundle := capabilities["security_service_grants"]()
make enforcement_bundle := capabilities["security_enforcement_grants"]()
assert(capabilities["permits"](sensor_bundle, "security.telemetry.publish"), "sensor bundle may publish normalized security events")
assert(not capabilities["permits"](sensor_bundle, "security.process.terminate"), "sensor bundle never has enforcement authority")
assert(capabilities["permits"](service_bundle, "security.events.read"), "analysis service may read events")
assert(not capabilities["permits"](service_bundle, "security.file.restore"), "analysis service cannot restore user data")
assert(capabilities["permits"](enforcement_bundle, "security.file.restore"), "separate enforcement bundle defines explicit restore authority")
