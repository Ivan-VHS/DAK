# Memory arithmetic contract.
# Addresses and limits are unsigned 63-bit values represented as Reaper integers.
# The upper limit of a region is exclusive.

export craft align_up(address, alignment) {
    make max_address := 9223372036854775807
    when address < 0 or address > max_address or alignment <= 0 {
        yield -1
    }

    make remainder := address % alignment
    when remainder == 0 {
        yield address
    }

    make increment := alignment - remainder
    when increment > max_address - address {
        yield -1
    }
    yield address + increment
}

export craft region_fits(base, bytes, limit, alignment) {
    when base < 0 or bytes <= 0 or alignment <= 0 {
        yield false
    }
    when base % alignment != 0 or base > limit {
        yield false
    }
    yield bytes <= limit - base
}

export craft ranges_overlap(left_base, left_bytes, right_base, right_bytes) {
    when left_base < 0 or right_base < 0 or left_bytes <= 0 or right_bytes <= 0 {
        yield false
    }
    when left_base <= right_base {
        yield right_base - left_base < left_bytes
    }
    yield left_base - right_base < right_bytes
}

export craft arena_reserve(cursor, bytes, limit, alignment) {
    when bytes <= 0 or limit < 0 {
        yield [-1, false]
    }

    make start := align_up(cursor, alignment)
    when start < 0 or start > limit {
        yield [-1, false]
    }
    when bytes > limit - start {
        yield [start, false]
    }
    yield [start + bytes, true]
}

export craft page_range_end(base, pages) {
    make max_address := 9223372036854775807
    when base < 0 or base % 4096 != 0 or pages <= 0 or pages > max_address / 4096 {
        yield -1
    }

    make bytes := pages * 4096
    when base > max_address - bytes {
        yield -1
    }
    yield base + bytes
}

export craft range_contains(parent_base, parent_pages, child_base, child_pages) {
    make parent_end := page_range_end(parent_base, parent_pages)
    make child_end := page_range_end(child_base, child_pages)
    when parent_end < 0 or child_end < 0 {
        yield false
    }
    yield child_base >= parent_base and child_end <= parent_end
}
