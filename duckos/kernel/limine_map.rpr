# Limine memory-map classification for DuckOS boot-info v1.
# Input entry: [base_high_u32, base_low_u32, length_high_u32, length_low_u32, limine_type].
# This maps memory-region types only. It does not dereference bootloader pointers,
# read physical memory, construct page tables or reclaim bootloader memory.

export craft memory_type(limine_type) {
    # DuckOS v1: usable=1, reserved=2, ACPI reclaimable=3,
    # ACPI NVS=4, MMIO=5, bad=6.
    when limine_type == 0 {
        yield [1, false]
    }
    when limine_type == 1 {
        yield [2, false]
    }
    when limine_type == 2 {
        yield [3, false]
    }
    when limine_type == 3 {
        yield [4, false]
    }
    when limine_type == 4 {
        yield [6, false]
    }
    when limine_type == 5 {
        # Keep bootloader-reclaimable pages reserved until a native consumer
        # proves every response and module reference has been released.
        yield [2, true]
    }
    when limine_type == 6 {
        # Executable and module payloads are not general-purpose free RAM.
        yield [2, false]
    }
    when limine_type == 7 {
        yield [5, false]
    }
    when limine_type == 8 {
        yield [2, false]
    }
    yield [0, false]
}

export craft u64_words_valid(high, low) {
    yield high >= 0 and high <= 4294967295 and low >= 0 and low <= 4294967295
}

export craft u64_is_zero(high, low) {
    yield high == 0 and low == 0
}

export craft u64_range_valid(base_high, base_low, length_high, length_low) {
    when not (u64_words_valid(base_high, base_low) and u64_words_valid(length_high, length_low)) {
        yield false
    }
    when u64_is_zero(length_high, length_low) {
        yield false
    }
    make low_sum := base_low + length_low
    vary carry := 0
    when low_sum >= 4294967296 {
        change carry := 1
    }
    make high_sum := base_high + length_high + carry
    yield high_sum <= 4294967295
}

export craft u64_end_high(base_high, base_low, length_high, length_low) {
    make low_sum := base_low + length_low
    vary carry := 0
    when low_sum >= 4294967296 {
        change carry := 1
    }
    yield base_high + length_high + carry
}

export craft u64_end_low(base_high, base_low, length_high, length_low) {
    yield (base_low + length_low) % 4294967296
}

export craft u64_less(first_high, first_low, second_high, second_low) {
    when first_high < second_high {
        yield true
    }
    when first_high > second_high {
        yield false
    }
    yield first_low < second_low
}

export craft region_valid(region) {
    when size(region) != 5 {
        yield false
    }
    when not u64_range_valid(region[0], region[1], region[2], region[3]) {
        yield false
    }
    yield memory_type(region[4])[0] != 0
}

export craft regions_ordered(previous, current) {
    when not (region_valid(previous) and region_valid(current)) {
        yield false
    }
    make previous_end_high := u64_end_high(previous[0], previous[1], previous[2], previous[3])
    make previous_end_low := u64_end_low(previous[0], previous[1], previous[2], previous[3])
    yield not u64_less(current[0], current[1], previous_end_high, previous_end_low)
}

export craft translate_region(region) {
    when not region_valid(region) {
        yield ["reject", nothing]
    }
    make mapped_type := memory_type(region[4])
    yield ["translated", [region[0], region[1], region[2], region[3], mapped_type[0], mapped_type[1]]]
}

export craft translate_map(regions) {
    make empty_regions := []
    when size(regions) == 0 or size(regions) > 256 {
        yield ["reject", "region-count", empty_regions]
    }
    vary translated := []
    each index in range(0, size(regions)) {
        make region := regions[index]
        when index > 0 {
            make previous := regions[index - 1]
            when not regions_ordered(previous, region) {
                yield ["reject", "unsorted-overlapping-or-invalid-region", empty_regions]
            }
        }
        make result := translate_region(region)
        when result[0] != "translated" {
            yield ["reject", "invalid-region", empty_regions]
        }
        change translated := push(translated, result[1])
    }
    yield ["translated", translated]
}

export craft reclaim_policy(region, boot_responses_released) {
    # Translated region: [base_hi, base_lo, length_hi, length_lo, duck_type, deferred_reclaim].
    when size(region) != 6 {
        yield "reject"
    }
    each word in [region[0], region[1], region[2], region[3]] {
        when word < 0 or word > 4294967295 {
            yield "reject"
        }
    }
    when region[2] == 0 and region[3] == 0 {
        yield "reject"
    }
    when region[4] != 2 or region[5] != true {
        yield "not-bootloader-reclaimable"
    }
    when not boot_responses_released {
        yield "retain-reserved"
    }
    yield "reclaim-eligible"
}
