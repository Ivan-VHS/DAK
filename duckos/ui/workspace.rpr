# Task-oriented workspace layout policy; the native host owns actual widgets.

export craft layout_for(context) {
    when context == "log.anomaly" {
        yield "timeline-diff"
    }
    when context == "schema.design" {
        yield "schema-canvas"
    }
    when context == "audio.mix" {
        yield "waveform-mixer"
    }
    when context == "device.inspect" {
        yield "device-graph"
    }
    yield "balanced-workspace"
}

export craft panels_for(context) {
    when context == "log.anomaly" {
        yield ["timeline", "diff", "filters", "lineage"]
    }
    when context == "schema.design" {
        yield ["canvas", "schema-inspector", "validation"]
    }
    when context == "audio.mix" {
        yield ["waveform", "meters", "routing", "presets"]
    }
    when context == "device.inspect" {
        yield ["device-graph", "telemetry", "driver-evidence"]
    }
    yield ["navigation", "workspace", "inspector"]
}

export craft focus_valid(context, focused_item) {
    yield context != "" and focused_item != ""
}

# Jora workspace requests are validated before the composer receives them.
# Components are supplied in topological order: every edge points forward.
# This prevents cycles without unbounded graph traversal.

export craft capabilities_subset(requested, granted) {
    vary valid := true
    each permission in requested {
        vary found := false
        each capability in granted {
            when permission == capability { change found := true }
        }
        when not found { change valid := false }
    }
    yield valid
}

export craft component_index(components, target_id) {
    vary found_index := -1
    vary index := 0
    each component in components {
        when size(component) == 4 and component[0] == target_id { change found_index := index }
        change index := index + 1
    }
    yield found_index
}

export craft workspace_component_valid(component, granted) {
    when size(component) != 4 { yield false }
    when component[0] == "" { yield false }
    when component[1] != "tile" and component[1] != "float" and component[1] != "stack" { yield false }
    when component[3] != "trusted" { yield false }
    yield capabilities_subset(component[2], granted)
}

export craft workspace_edge_valid(edge, components) {
    when size(edge) != 2 { yield false }
    when edge[0] == edge[1] { yield false }
    make from_index := component_index(components, edge[0])
    make to_index := component_index(components, edge[1])
    yield from_index >= 0 and to_index > from_index
}

export craft workspace_request_valid(request, granted) {
    when size(request) != 7 { yield false }
    when request[0] == "" or request[1] == "" { yield false }
    when request[2] != "floating" and request[2] != "tiling" and request[2] != "dynamic" { yield false }
    when request[3] != "latency" and request[3] != "modularity" and request[3] != "extensibility" { yield false }
    when size(request[4]) < 1 or size(request[4]) > 64 or request[6] < size(request[4]) or request[6] > 64 { yield false }
    when size(request[5]) > 256 { yield false }
    vary index := 0
    vary components_ok := true
    each component in request[4] {
        when not workspace_component_valid(component, granted) { change components_ok := false }
        when size(component) == 4 {
            when component_index(request[4], component[0]) != index { change components_ok := false }
        }
        change index := index + 1
    }
    when not components_ok { yield false }
    vary edges_ok := true
    each edge in request[5] {
        when not workspace_edge_valid(edge, request[4]) { change edges_ok := false }
    }
    yield edges_ok
}

export craft composition_decision(request, granted) {
    when not workspace_request_valid(request, granted) { yield "reject-invalid-workspace" }
    yield "jora-compose-request-ready"
}

export craft profile_switch_decision(profile_valid, dirty_state_saved, required_services_ready) {
    when not profile_valid { yield "reject-invalid-profile" }
    when not dirty_state_saved { yield "save-required" }
    when not required_services_ready { yield "services-not-ready" }
    yield "switch-transaction-ready"
}
