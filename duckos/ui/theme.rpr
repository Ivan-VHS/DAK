# DuckOS Industrial Glass material policy.
# Black/White/Gold is canonical; opaque paint is always a valid fallback.

export craft palette_ratios() {
    yield [65, 25, 10]
}

export craft palette_valid(ratios) {
    when size(ratios) != 3 {
        yield false
    }
    yield ratios[0] + ratios[1] + ratios[2] == 100 and ratios[0] >= ratios[1] and ratios[1] >= ratios[2]
}

export craft palette_color(role) {
    when role == "page" {
        yield "#050505"
    }
    when role == "surface" {
        yield "#101010"
    }
    when role == "elevated" {
        yield "#181818"
    }
    when role == "navigation" {
        yield "#FFD700"
    }
    when role == "accent" {
        yield "#FFD700"
    }
    when role == "alert" {
        yield "#FFD700"
    }
    when role == "border" {
        yield "#3A3A3A"
    }
    when role == "focus" {
        yield "#FFD700"
    }
    yield "#FFFFFF"
}

export craft glass_opacity(surface) {
    when surface == "modal" or surface == "chrome" {
        yield 0.86
    }
    when surface == "content" or surface == "notification" {
        yield 0.78
    }
    yield 1.0
}

export craft glass_blur(surface, reduce_transparency, eco_visuals) {
    when reduce_transparency or eco_visuals {
        yield 0
    }
    when surface == "modal" or surface == "chrome" {
        yield 22
    }
    when surface == "content" or surface == "notification" {
        yield 18
    }
    yield 0
}

export craft glass_surface_valid(surface, nesting_depth) {
    when nesting_depth < 0 or nesting_depth > 1 {
        yield false
    }
    yield surface == "chrome" or surface == "content" or surface == "modal" or surface == "notification"
}

export craft motion_profile(reduced_motion) {
    when reduced_motion {
        yield "static"
    }
    yield "digital-physics"
}
