# DuckOS single-palette design contract.
# 65% black, 25% white and 10% yellow.

export craft palette_ratios() {
    yield [65, 25, 10]
}

export craft palette_valid(ratios) {
    when size(ratios) != 3 {
        yield false
    }
    yield ratios[0] + ratios[1] + ratios[2] == 100 and ratios[0] >= ratios[1] and ratios[1] >= ratios[2]
}

export craft palette_color(role) {
    when role == "page" {
        yield "#050505"
    }
    when role == "surface" {
        yield "#101010"
    }
    when role == "elevated" {
        yield "#181818"
    }
    when role == "navigation" {
        yield "#FFD700"
    }
    when role == "accent" or role == "navigation" {
        yield "#FFD700"
    }
    when role == "alert" or role == "error" {
        yield "#FF7777"
    }
    when role == "success" {
        yield "#6EDAA3"
    }
    when role == "warning" or role == "brand" {
        yield "#FFD700"
    }
    when role == "info" {
        yield "#79B8FF"
    }
    when role == "border" {
        yield "#343434"
    }
    when role == "focus" {
        yield "#FFE36E"
    }
    yield "#FFFFFF"
}

export craft motion_profile(reduced_motion) {
    when reduced_motion {
        yield "static"
    }
    yield "fluid"
}
