# DuckOS single-palette design contract.
# 65% black, 25% white and 10% yellow.

export craft palette_ratios() {
    yield [65, 25, 10]
}

export craft palette_valid(ratios) {
    when size(ratios) != 3 {
        yield false
    }
    yield ratios[0] + ratios[1] + ratios[2] == 100 and ratios[0] >= ratios[1] and ratios[1] >= ratios[2]
}

export craft palette_color(role) {
    when role == "page" {
        yield "#080808"
    }
    when role == "surface" {
        yield "#151515"
    }
    when role == "elevated" {
        yield "#242424"
    }
    when role == "navigation" {
        yield "#FFD400"
    }
    when role == "accent" {
        yield "#FFD400"
    }
    when role == "alert" {
        yield "#FFD400"
    }
    when role == "border" {
        yield "#3A3A3A"
    }
    when role == "focus" {
        yield "#FFE45C"
    }
    yield "#FFFFFF"
}

export craft motion_profile(reduced_motion) {
    when reduced_motion {
        yield "static"
    }
    yield "fluid"
}


# Surface materials are hints to the host compositor; unsupported hosts stay opaque.
export craft material_profile(role) {
    when role == "glass" {
        yield ["#151515", 78, 18, "#FFD400"]
    }
    when role == "glass-strong" {
        yield ["#080808", 84, 22, "#FFD400"]
    }
    yield ["#151515", 100, 0, "#3A3A3A"]
}

export craft material_mode(backdrop_supported, reduced_transparency, forced_colors) {
    when forced_colors {
        yield "system-opaque"
    }
    when reduced_transparency or not backdrop_supported {
        yield "opaque"
    }
    yield "frosted"
}
