# DAK single-palette design contract — Ivan-VHS.
# Imperial Noir & Glass: black canvas, white information, restrained warm gold.

export craft palette_ratios() {
    yield [65, 25, 10]
}

export craft palette_valid(ratios) {
    when size(ratios) != 3 {
        yield false
    }
    yield ratios[0] + ratios[1] + ratios[2] == 100 and ratios[0] >= ratios[1] and ratios[1] >= ratios[2]
}

export craft palette_color(role) {
    when role == "page" {
        yield "#050505"
    }
    when role == "surface" {
        yield "#101010"
    }
    when role == "elevated" {
        yield "#171717"
    }
    when role == "navigation" {
        yield "#FFD700"
    }
    when role == "accent" {
        yield "#FFD700"
    }
    when role == "alert" {
        yield "#FFD700"
    }
    when role == "border" {
        yield "#343434"
    }
    when role == "focus" {
        yield "#FFE6A3"
    }
    yield "#FFFFFF"
}

export craft motion_profile(reduced_motion) {
    when reduced_motion {
        yield "static"
    }
    yield "fluid"
}
