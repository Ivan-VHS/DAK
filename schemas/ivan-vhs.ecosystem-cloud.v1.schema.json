{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/DuckOS/blob/main/schemas/ivan-vhs.ecosystem-cloud.v1.schema.json",
  "title": "Ivan-VHS Ecosystem Cloud Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "provider",
    "architecture",
    "default_mode",
    "network",
    "identity",
    "authorization",
    "shared_domains",
    "storage",
    "forbidden_data_classes",
    "synchronization",
    "repositories",
    "rollout"
  ],
  "properties": {
    "schema": {
      "const": "ivan-vhs.ecosystem-cloud.v1"
    },
    "version": {
      "const": 1
    },
    "status": {
      "enum": [
        "foundation",
        "locally-verified",
        "hosted-deployed"
      ]
    },
    "provider": {
      "const": "supabase"
    },
    "architecture": {
      "const": "local-first-cloud-optional"
    },
    "default_mode": {
      "const": "local-only"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "enablement",
        "credentials",
        "retry",
        "offline_fallback"
      ],
      "properties": {
        "default": {
          "const": "disabled"
        },
        "enablement": {
          "const": "explicit-user-opt-in"
        },
        "credentials": {
          "const": "user-managed-secret-store"
        },
        "retry": {
          "const": "bounded-idempotent"
        },
        "offline_fallback": {
          "const": "required"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "local_identity",
        "subject"
      ],
      "properties": {
        "authority": {
          "const": "supabase-auth-when-connected"
        },
        "local_identity": {
          "const": "not-required"
        },
        "subject": {
          "const": "auth.users.id"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database",
        "default_role",
        "client_role_mutation",
        "service_role_in_client"
      ],
      "properties": {
        "database": {
          "const": "postgres-rls"
        },
        "default_role": {
          "const": "least-privilege"
        },
        "client_role_mutation": {
          "const": false
        },
        "service_role_in_client": {
          "const": false
        }
      }
    },
    "shared_domains": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose"
        ],
        "properties": {
          "id": {
            "enum": [
              "organizations",
              "projects",
              "artifact-metadata",
              "sync-receipts",
              "audit-events"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket",
        "visibility",
        "max_object_size_bytes",
        "object_key",
        "public_urls",
        "upload_mode"
      ],
      "properties": {
        "bucket": {
          "const": "ecosystem-artifacts"
        },
        "visibility": {
          "const": "private"
        },
        "max_object_size_bytes": {
          "const": 104857600
        },
        "object_key": {
          "const": "<organization UUID>/<project key>/<artifact UUID>"
        },
        "public_urls": {
          "const": false
        },
        "upload_mode": {
          "const": "explicit-user-action-only"
        }
      }
    },
    "forbidden_data_classes": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "synchronization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_storage",
        "idempotency_key",
        "client_instance_id",
        "conflict_policy",
        "offline_queue"
      ],
      "properties": {
        "payload_storage": {
          "const": "domain-specific-only"
        },
        "idempotency_key": {
          "const": "actor_id+client_instance_id+event_id"
        },
        "client_instance_id": {
          "const": "random UUID; never hardware-derived"
        },
        "conflict_policy": {
          "const": "domain-specific; no blind last-write-wins"
        },
        "offline_queue": {
          "const": "local-first"
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "project_key",
          "adapter",
          "eligible",
          "forbidden"
        ],
        "properties": {
          "id": {
            "enum": [
              "duckos",
              "reaper",
              "pytyliki",
              "oplague",
              "ventusample"
            ]
          },
          "project_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "adapter": {
            "const": "federation/ecosystem-cloud-adapter.v1.json"
          },
          "eligible": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "forbidden": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hosted_project",
        "hosted_migrations",
        "ci",
        "cli_version",
        "required_checks"
      ],
      "properties": {
        "hosted_project": {
          "enum": [
            "not-configured",
            "configured"
          ]
        },
        "hosted_migrations": {
          "enum": [
            "not-deployed",
            "deployed"
          ]
        },
        "ci": {
          "const": "local-supabase-stack-only"
        },
        "cli_version": {
          "const": "3.4.0"
        },
        "required_checks": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
