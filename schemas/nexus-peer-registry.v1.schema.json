{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/DuckOS/blob/main/schemas/nexus-peer-registry.v1.schema.json",
  "title": "DuckOS NEXUS peer contract registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "integration_host",
    "source_of_revision",
    "topology",
    "policy",
    "peers"
  ],
  "properties": {
    "schema": {
      "const": "duckos.nexus-peer-registry.v1"
    },
    "version": {
      "const": 1
    },
    "integration_host": {
      "const": "DuckOS"
    },
    "source_of_revision": {
      "const": "federation/repositories.v1.json"
    },
    "topology": {
      "const": "direct-versioned-peer-contracts"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_exchange",
        "native_library_loading",
        "desktop_wire_transport",
        "peer_optional",
        "central_runtime_required",
        "automatic_discovery",
        "automatic_execution",
        "kernel_privilege_from_peer_contracts",
        "device_access_default",
        "audio_processing_default",
        "unavailable_peer_behavior"
      ],
      "properties": {
        "default_exchange": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "native_library_loading": {
          "type": "string",
          "minLength": 1
        },
        "desktop_wire_transport": {
          "type": "string",
          "minLength": 1
        },
        "peer_optional": {
          "const": true
        },
        "central_runtime_required": {
          "const": false
        },
        "automatic_discovery": {
          "const": false
        },
        "automatic_execution": {
          "const": false
        },
        "kernel_privilege_from_peer_contracts": {
          "const": false
        },
        "device_access_default": {
          "const": "read-only"
        },
        "audio_processing_default": {
          "const": "offline"
        },
        "unavailable_peer_behavior": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "peers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "path",
          "role",
          "workbench_maturity",
          "contracts",
          "prohibited_effects"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "reaper",
              "pytyliki",
              "oplague",
              "ventusample"
            ]
          },
          "repository": {
            "type": "string",
            "pattern": "^Ivan-VHS/[A-Za-z0-9_.-]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^projects/[a-z][a-z0-9-]*$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "workbench_maturity": {
            "type": "string",
            "minLength": 1
          },
          "contracts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "source",
                "maturity",
                "purpose",
                "consumer_rules"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]*\\.v1$"
                },
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "pattern": "^projects/[a-z][a-z0-9-]*/docs/.+\\.md$"
                },
                "maturity": {
                  "type": "string",
                  "minLength": 1
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                },
                "consumer_rules": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "prohibited_effects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
