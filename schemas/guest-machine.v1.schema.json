{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/DuckOS/blob/main/schemas/guest-machine.v1.schema.json",
  "title": "DuckOS registered guest machine v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "disk_path", "disk_format", "disk_size_bytes", "disk_sha256", "memory_mb", "cpus", "registered_at"],
  "properties": {
    "schema": {"const": "duckos.guest-machine.v1"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
    "disk_path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "disk_format": {"enum": ["qcow2", "raw"]},
    "disk_size_bytes": {"type": "integer", "minimum": 1048576},
    "disk_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "memory_mb": {"type": "integer", "minimum": 1024, "maximum": 65536},
    "cpus": {"type": "integer", "minimum": 1, "maximum": 32},
    "registered_at": {"type": "string", "format": "date-time"}
  }
}