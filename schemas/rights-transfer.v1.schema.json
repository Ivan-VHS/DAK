{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duckos.dev/schemas/rights-transfer.v1.schema.json",
  "title": "DuckOS rights-preserving transfer metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "created_at",
    "items",
    "entitlement_handling",
    "authorization_granted"
  ],
  "properties": {
    "schema": {
      "const": "duckos.rights-transfer.v1"
    },
    "version": {
      "const": 1
    },
    "created_at": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content_id",
          "content_manifest",
          "entitlement",
          "save_metadata"
        ],
        "properties": {
          "content_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "content_manifest": {
            "$ref": "content-manifest.v1.schema.json"
          },
          "entitlement": {
            "oneOf": [
              {
                "$ref": "entitlement.v1.schema.json"
              },
              {
                "type": "null"
              }
            ]
          },
          "save_metadata": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "entitlement_handling": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "authorization_granted": {
      "const": false
    }
  }
}
