{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duckos.dev/schemas/content-manifest.v1.schema.json",
  "title": "DuckOS publisher content manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "content",
    "publisher",
    "attribution",
    "files",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "duckos.content-manifest.v1"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "kind": {
          "enum": [
            "game",
            "dlc",
            "theme",
            "media",
            "system_module",
            "save",
            "user_asset",
            "avatar",
            "preset",
            "mod"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "version": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "attribution": {
      "type": "object",
      "required": [
        "creator",
        "source",
        "copyright"
      ],
      "properties": {
        "creator": {
          "type": [
            "object",
            "string"
          ]
        },
        "source": {
          "type": "object"
        },
        "copyright": {
          "type": "object"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "capture_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "screenshot",
              "recording",
              "streaming"
            ]
          }
        },
        "denied_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "screenshot",
              "recording",
              "streaming"
            ]
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "value": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  }
}
