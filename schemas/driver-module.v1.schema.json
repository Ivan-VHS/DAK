{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/DuckOS/blob/main/schemas/driver-module.v1.schema.json",
  "title": "DuckOS driver module descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "version", "architecture", "kernel_abi", "entry_symbol", "dependencies", "capabilities"],
  "properties": {
    "schema": {"const": "duckos.driver-module.v1"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "architecture": {"enum": ["x86_64", "aarch64", "riscv64", "i686"]},
    "kernel_abi": {"type": "string", "minLength": 1, "maxLength": 128},
    "entry_symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
    "dependencies": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}},
    "capabilities": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}}
  }
}
