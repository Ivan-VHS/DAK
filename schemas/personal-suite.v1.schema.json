{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/DuckOS/blob/main/schemas/personal-suite.v1.schema.json",
  "title": "DuckOS Personal Suite v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "operating_system",
    "desktop",
    "maturity_status",
    "runtime",
    "storage",
    "applications"
  ],
  "properties": {
    "schema": {
      "const": "duckos.personal-suite.v1"
    },
    "version": {
      "const": 1
    },
    "operating_system": {
      "const": "DuckOS"
    },
    "desktop": {
      "const": "Mora"
    },
    "maturity_status": {
      "enum": [
        "specified",
        "partial",
        "implemented",
        "verified"
      ]
    },
    "runtime": {
      "type": "string"
    },
    "storage": {
      "type": "object",
      "required": [
        "provider",
        "cloud_sync",
        "network_requests",
        "encryption_at_rest"
      ],
      "properties": {
        "provider": {
          "const": "browser-localStorage"
        },
        "cloud_sync": {
          "const": false
        },
        "network_requests": {
          "const": false
        },
        "encryption_at_rest": {
          "const": false
        },
        "user_export": {
          "type": "string"
        },
        "user_import": {
          "type": "string"
        },
        "profile_scope": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "applications": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "domain",
          "privacy_class",
          "maturity_status",
          "capabilities",
          "boundaries"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+(-[a-z]+)+$"
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "domain": {
            "enum": [
              "health",
              "style",
              "creative",
              "home"
            ]
          },
          "privacy_class": {
            "enum": [
              "private",
              "sensitive"
            ]
          },
          "maturity_status": {
            "enum": [
              "specified",
              "partial",
              "implemented",
              "verified"
            ]
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "boundaries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
