{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/DuckOS/blob/main/schemas/bav-evidence.v1.schema.json",
  "title": "DuckOS BAV signed evidence bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "magic",
    "media_type",
    "created_at_unix_ms",
    "engine",
    "payload_digest",
    "records",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "duckos.bav-evidence.v1"
    },
    "version": {
      "const": 1
    },
    "magic": {
      "const": "DUCKBAV1"
    },
    "media_type": {
      "const": "application/vnd.duckos.bav+json"
    },
    "created_at_unix_ms": {
      "type": "integer",
      "minimum": 1
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "records": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_digest",
          "verdict",
          "confidence_basis_points",
          "action",
          "evidence_ids"
        ],
        "properties": {
          "target_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "verdict": {
            "enum": [
              "clean",
              "suspicious",
              "malicious",
              "unknown"
            ]
          },
          "confidence_basis_points": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "action": {
            "enum": [
              "none",
              "review",
              "block",
              "quarantine-reversible"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "minLength": 80,
          "maxLength": 128
        }
      }
    }
  }
}
