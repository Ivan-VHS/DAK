{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/DAK/blob/main/schemas/image-layout.v1.schema.json",
  "title": "DAK dry-run image layout v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sector_size", "alignment_bytes", "image_size_bytes", "partitions", "write_performed", "bootability_verified"],
  "properties": {
    "schema": {"const": "dak.image-layout.v1"},
    "sector_size": {"enum": [512, 1024, 2048, 4096]},
    "alignment_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
    "image_size_bytes": {"type": "integer", "minimum": 1, "maximum": 68719476736},
    "partitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "name", "type", "start_byte", "end_byte_exclusive", "start_sector", "sector_count", "size_bytes", "alignment_bytes"],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
          "type": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
          "start_byte": {"type": "integer", "minimum": 0},
          "end_byte_exclusive": {"type": "integer", "minimum": 1},
          "start_sector": {"type": "integer", "minimum": 0},
          "sector_count": {"type": "integer", "minimum": 1},
          "size_bytes": {"type": "integer", "minimum": 1},
          "alignment_bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "write_performed": {"const": false},
    "bootability_verified": {"const": false}
  }
}
