{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Ivan-VHS/DuckOS/blob/main/schemas/jora-app-package.v1.schema.json",
  "title":"Jora generated application package manifest v1",
  "type":"object",
  "additionalProperties":true,
  "required":["schema","format_version","app","formula","runtime","graph","content","build","integrity","generation"],
  "properties":{
    "schema":{"const":"jora.app-package.v1"},
    "format_version":{"const":1},
    "app":{"type":"object","required":["id","display_name","alternative_names","tagline"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"display_name":{"type":"string","minLength":1,"maxLength":64},"alternative_names":{"type":"array","items":{"type":"string"},"maxItems":8},"tagline":{"type":"string","maxLength":240}}},
    "formula":{"type":"object","required":["source","canonical","components","sha256"],"properties":{"source":{"type":"string","maxLength":2048},"canonical":{"type":"string"},"components":{"type":"array","minItems":1,"maxItems":64},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "runtime":{"type":"object","required":["core_language","selected_languages","target_profile"]},
    "graph":{"type":"object","required":["path","topology","node_count","edge_count"]},
    "content":{"type":"object","required":["path","audio_payload_included","generated_from_seed_scenario"]},
    "build":{"type":"object","required":["status","compiled","tested","published","installation_performed"]},
    "integrity":{"type":"object","required":["algorithm","files"],"properties":{"algorithm":{"const":"sha256"},"files":{"type":"object","additionalProperties":{"type":"object","required":["size_bytes","sha256"],"properties":{"size_bytes":{"type":"integer","minimum":0},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}}},
    "generation":{"type":"object","required":["generator","generator_version","reproducibility"]}
  }
}
