{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duckos.local/schemas/jora-app-package.v1.schema.json",
  "title": "DuckOS Jora App Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "app", "formula", "formula_hash", "graph", "languages", "generator", "reaper", "permissions", "dependencies", "files", "total_bytes", "verification", "created_at"],
  "properties": {
    "schema": {"const": "duckos.jora.app-package.v1"},
    "version": {"type": "string", "minLength": 1, "maxLength": 32},
    "app": {
      "type": "object",
      "required": ["display_name", "slug", "app_id", "tagline", "description"],
      "properties": {
        "display_name": {"type": "string", "minLength": 1, "maxLength": 100},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "app_id": {"type": "string", "pattern": "^[a-z0-9.]+$"},
        "tagline": {"type": "string"},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "formula": {"type": "object"},
    "formula_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "graph": {
      "type": "object",
      "required": ["schema", "node_count", "edge_count", "max_synergy_neighbors", "topology"],
      "properties": {
        "schema": {"const": "duckos.jora.graph.v1"},
        "node_count": {"type": "integer", "minimum": 2},
        "edge_count": {"type": "integer", "minimum": 1},
        "max_synergy_neighbors": {"type": "integer", "minimum": 1, "maximum": 16},
        "topology": {"const": "bounded_hub_cluster"}
      },
      "additionalProperties": false
    },
    "languages": {"type": "object"},
    "generator": {"type": "object"},
    "reaper": {"type": "object"},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "object"}},
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "additionalProperties": {
        "type": "object",
        "required": ["size_bytes", "sha256"],
        "properties": {
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "total_bytes": {"type": "integer", "minimum": 0, "maximum": 134217728},
    "verification": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}