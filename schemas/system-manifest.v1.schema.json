{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/DAK/blob/main/schemas/system-manifest.v1.schema.json",
  "title": "DAK system manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "version", "architecture", "kernel_abi", "components"],
  "properties": {
    "schema": {"const": "dak.system-manifest.v1"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "architecture": {"enum": ["x86_64", "aarch64", "riscv64", "i686"]},
    "kernel_abi": {"type": "string", "minLength": 1, "maxLength": 128},
    "components": {
      "type": "array",
      "minItems": 4,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "size_bytes", "sha256"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
          "path": {"type": "string", "minLength": 1, "maxLength": 1024},
          "size_bytes": {"type": "integer", "minimum": 1, "maximum": 8589934592},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
