{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duckos.dev/schemas/entitlement.v1.schema.json",
  "title": "DuckOS publisher entitlement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "entitlement_id",
    "issuer",
    "content",
    "license",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "duckos.entitlement.v1"
    },
    "entitlement_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "manifest_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "kind": {
          "enum": [
            "game",
            "dlc",
            "theme",
            "media",
            "system_module",
            "save",
            "user_asset",
            "avatar",
            "preset",
            "mod"
          ]
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "profile_id",
        "home_device_id",
        "rights",
        "issued_at",
        "not_before",
        "expires_at",
        "offline_valid_until",
        "region"
      ],
      "properties": {
        "scope": {
          "enum": [
            "profile",
            "home_device"
          ]
        },
        "profile_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "home_device_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "rights": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "install",
              "launch",
              "download",
              "backup",
              "transfer",
              "stream",
              "capture_screenshot",
              "capture_recording",
              "redistribute",
              "modify"
            ]
          }
        },
        "issued_at": {
          "type": "integer",
          "minimum": 0
        },
        "not_before": {
          "type": "integer",
          "minimum": 0
        },
        "expires_at": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "offline_valid_until": {
          "type": "integer",
          "minimum": 0
        },
        "region": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 16
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "value": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "license": {
          "properties": {
            "scope": {
              "const": "profile"
            },
            "profile_id": {
              "type": "string"
            },
            "home_device_id": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "properties": {
        "license": {
          "properties": {
            "scope": {
              "const": "home_device"
            },
            "profile_id": {
              "type": "null"
            },
            "home_device_id": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
