# DAK integration contract suite.
# Run with Reaper's tree-walk engine and VM.

import "dak/kernel/boot.rpr" as boot
import "dak/kernel/memory.rpr" as memory
import "dak/kernel/arena.rpr" as arena
import "dak/kernel/scheduler.rpr" as scheduler
import "dak/kernel/flock.rpr" as flock
import "dak/kernel/ipc.rpr" as ipc
import "dak/kernel/zero_copy_bus.rpr" as bus
import "dak/security/capabilities.rpr" as capabilities
import "dak/security/trust.rpr" as trust
import "dak/drivers/abi.rpr" as drivers
import "dak/drivers/orchestrator.rpr" as orchestrator
import "dak/services/supervisor.rpr" as supervisor
import "dak/storage/hypergraph.rpr" as storage
import "dak/storage/crdt.rpr" as crdt
import "dak/system/three_media.rpr" as media
import "dak/system/telemetry.rpr" as telemetry
import "dak/gpu/oplage_bridge.rpr" as oplage_gpu
import "dak/ui/theme.rpr" as theme
import "dak/ui/motion.rpr" as motion
import "dak/storage/history.rpr" as history
import "dak/ui/workspace.rpr" as workspace
import "dak/system/prefetch.rpr" as prefetch
import "dak/ui/config.rpr" as config
import "dak/system/recovery.rpr" as recovery
import "dak/ui/physics.rpr" as physics
import "dak/ui/command_palette.rpr" as palette
import "dak/security/plugin_sandbox.rpr" as plugin_sandbox
import "dak/ui/canvas.rpr" as canvas
import "dak/input/spatial.rpr" as spatial_input
import "dak/ui/desktop.rpr" as desktop
import "dak/system/installer.rpr" as installer
import "dak/drivers/runtime.rpr" as driver_runtime
import "dak/packages/manager.rpr" as packages
import "dak/system/updates.rpr" as updates

make phases := ["reset", "firmware", "memory", "interrupts", "scheduler", "ipc", "drivers", "services", "desktop"]
assert(boot["sequence_valid"](phases), "boot phases must remain ordered")
assert(boot["transition_valid"]("memory", "interrupts"), "memory must precede interrupt setup")
assert(not boot["transition_valid"]("drivers", "scheduler"), "boot must reject skipped phases")
assert(boot["failure_action"](0) == "continue", "successful phase must continue")
assert(boot["failure_action"](1) == "recovery", "failed phase must enter recovery")

assert(memory["align_up"](17, 16) == 32, "arena alignment")
assert(memory["align_up"](32, 16) == 32, "aligned address must remain unchanged")
assert(memory["align_up"](9223372036854775800, 16) == -1, "alignment must reject signed address overflow")
assert(memory["region_fits"](4096, 1024, 8192, 4096), "valid aligned region")
assert(not memory["region_fits"](4097, 1024, 8192, 4096), "unaligned region must be rejected")
assert(memory["ranges_overlap"](100, 40, 120, 10), "overlapping ranges")
assert(not memory["ranges_overlap"](100, 20, 120, 10), "adjacent ranges do not overlap")
assert(memory["ranges_overlap"](9223372036854775800, 10, 9223372036854775805, 1), "overlap check must avoid end-address overflow")
assert(not memory["ranges_overlap"](-1, 5, 1, 2), "negative physical addresses must be rejected")
assert(memory["arena_reserve"](100, 20, 256, 16) == [132, true], "bounded arena reservation")
assert(memory["arena_reserve"](240, 32, 256, 16) == [240, false], "arena must reject overflow")

make frame := arena["create"](4096, 8192)
assert(frame == ["ready", [4096, 4096, 8192, 0]], "frame arena starts at its aligned base")
make first_frame_allocation := arena["reserve"](frame[1], 100)
assert(first_frame_allocation == ["reserved", [4096, 4196, 8192, 0], 4096], "frame arena reserves an aligned span")
make reset_frame := arena["reset"](first_frame_allocation[1])
assert(reset_frame == ["reset", [4096, 4096, 8192, 1]], "frame arena resets in constant-size state")
assert(arena["soa_layout"](17, 4, 8, 128) == ["ready", 24, 96, 7], "SoA lanes are padded to vector width")
assert(arena["soa_layout"](17, 4, 8, 64)[0] == "over-budget", "SoA layout respects the declared budget")

make tasks := [
    ["idle", 0, 100, "ready"],
    ["audio", 8, 40, "ready"],
    ["desktop", 8, 30, "ready"],
    ["blocked", 99, 1, "blocked"]
]
assert(scheduler["pick_ready"](tasks) == "desktop", "scheduler priority/deadline ordering")
assert(scheduler["pick_ready"]([["sleeping", 7, 1, "blocked"]]) == "", "blocked task must not run")
make workers := [["cpu0", 8, 10, true], ["cpu1", 1, 4, true], ["offline", 0, 64, false]]
assert(flock["choose_worker"](workers, 1) == ["assigned", "cpu1", 2], "flock chooses the least-loaded eligible worker")
assert(flock["choose_worker"]([["full", 4, 4, true]], 1) == ["backpressure", "", 0], "flock refuses a saturated worker")

make sent := ipc["send"]([1, 2], 3, 3)
assert(sent == ["sent", [1, 2, 3]], "queue accepts data below capacity")
make full := ipc["send"]([1, 2], 2, 3)
assert(full == ["backpressure", [1, 2]], "full queue must remain unchanged")
assert(ipc["receive"]([]) == ["empty", [], nothing], "empty receive")
assert(ipc["receive"]([4, 5]) == ["received", [5], 4], "FIFO receive order")

make shared_bus := bus["create"](1024, 75)
make published_a := bus["publish"](shared_bus[1], 512)
make published_b := bus["publish"](published_a[1], 256)
assert(published_a == ["published", [1024, 512, 1, 0, 75], 1], "bus publication reserves bounded capacity")
assert(bus["pressured"](published_b[1]), "bus raises pressure at its high watermark")
assert(bus["publish"](published_b[1], 300)[0] == "backpressure", "bus refuses a payload larger than remaining capacity")
make consumed := bus["consume"](published_b[1], 256)
assert(consumed == ["consumed", [1024, 512, 2, 1, 75]], "consumer releases accounted bytes")

make grants := ["read.device", "telemetry.publish", "memory.map", "sanitize"]
assert(capabilities["permits"](grants, "read.device"), "declared capability is available")
assert(not capabilities["permits"](grants, "write.firmware"), "undeclared capability is denied")
assert(capabilities["child_is_subset"](grants, ["read.device"]), "child may retain a subset")
assert(not capabilities["child_is_subset"](grants, ["read.device", "write.firmware"]), "child cannot amplify authority")
assert(trust["promote"]("untrusted", true) == "validated", "validated input may leave the untrusted state")
assert(trust["promote"]("untrusted", false) == "quarantined", "failed validation enters quarantine")
assert(not trust["effect_allowed"]("untrusted", grants, "read.device"), "untrusted data cannot exercise device access")
assert(trust["effect_allowed"]("untrusted", grants, "sanitize"), "untrusted data may only cross the sanitizer boundary")
assert(trust["effect_allowed"]("validated", grants, "read.device"), "validated data still requires a granted capability")

make valid_driver := ["nvme.sample", 1, "pci", ["read.device", "memory.map"]]
make bad_driver := ["unknown.sample", 2, "mystery", ["write.firmware"]]
make privileged_driver := ["flash.writer", 1, "pci", ["write.firmware"]]
assert(drivers["descriptor_valid"](valid_driver, 1, ["pci", "usb", "acpi"]), "valid driver descriptor")
assert(not drivers["descriptor_valid"](bad_driver, 1, ["pci", "usb", "acpi"]), "unsupported descriptor rejected")
assert(drivers["load_policy"](valid_driver, 1, ["pci", "usb"], grants) == "descriptor-approved", "driver policy accepts declared safe descriptor")
assert(drivers["load_policy"](privileged_driver, 1, ["pci", "usb"], grants) == "reject", "driver cannot request an ungranted capability")
assert(drivers["load_policy"](bad_driver, 1, ["pci", "usb"], grants) == "reject", "driver policy rejects unsafe descriptor")

make device_a := ["nvme0", "pci", 4096, 256, 11, true]
make device_b := ["gpu0", "pci", 4200, 128, 11, false]
make device_c := ["audio0", "usb", 8192, 256, 5, false]
assert(orchestrator["device_valid"](device_a), "device descriptor shape")
assert(orchestrator["resources_conflict"](device_a, device_b), "overlapping device resources are reported")
assert(not orchestrator["resources_conflict"](device_a, device_c), "independent device resources do not conflict")
make signed_package := ["nvme.safe", 1, "pci", "x86_64", ["read.device"], true]
make unsigned_package := ["nvme.unsigned", 1, "pci", "x86_64", ["read.device"], false]
make wrong_arch_package := ["nvme.arm", 1, "pci", "aarch64", ["read.device"], true]
assert(orchestrator["package_policy"](signed_package, device_a, "x86_64", 1, ["pci", "usb"], grants) == "approved", "signed package descriptor passes policy")
assert(orchestrator["package_policy"](unsigned_package, device_a, "x86_64", 1, ["pci", "usb"], grants) == "reject", "unsigned package is rejected")
assert(orchestrator["package_policy"](wrong_arch_package, device_a, "x86_64", 1, ["pci", "usb"], grants) == "reject", "package for a different architecture is rejected")

assert(supervisor["decide"](0, 0, 3) == ["stopped", 0], "clean stop is not restarted")
assert(supervisor["decide"](1, 1, 3) == ["restart", 2], "crashed service receives bounded retry")
assert(supervisor["decide"](1, 3, 3) == ["failed", 3], "restart budget is finite")

make known := ["blake3:aaa", "blake3:bbb"]
assert(storage["node_valid"](["blake3:ccc", "record", ["blake3:aaa"]], known), "graph node may reference known content")
make no_dependencies := []
assert(not storage["node_valid"](["blake3:aaa", "record", no_dependencies], known), "known hash cannot be reused as a new node")
assert(not storage["node_valid"](["blake3:ddd", "record", ["blake3:missing"]], known), "unknown dependency is rejected")
make journal := storage["journal_append"]([], "boot.started", "firmware")
make journal2 := storage["journal_append"](journal, "memory.ready", "arena0")
assert(storage["journal_valid"](journal2), "event journal sequence")
assert(not storage["journal_valid"]([[2, "bad.sequence", "x"]]), "event journal rejects gaps")
make register_left := ["old", 4, "actor-a"]
make register_right := ["new", 5, "actor-b"]
assert(crdt["merge_register"](register_left, register_right) == register_right, "CRDT merge chooses the newer Lamport value")
assert(crdt["merge_register"](register_right, register_left) == register_right, "CRDT merge is independent of arrival order")
assert(crdt["merge_register"](["alpha", 7, "actor-a"], ["zeta", 7, "actor-b"]) == ["alpha", 7, "actor-a"], "actor id breaks equal-clock ties")
assert(crdt["merge_register"](["alpha", 7, "actor-a"], ["zeta", 7, "actor-a"]) == ["zeta", 7, "actor-a"], "canonical value text breaks duplicate actor ties")

assert(media["choose_medium"](512, 2, true, true) == "land", "small scalar work stays on CPU")
assert(media["choose_medium"](4096, 16, true, false) == "water", "dense batch may select accelerator")
assert(media["choose_medium"](9000, 4, false, true) == "sky", "large batch may select node mesh")
assert(media["backpressure"](10, 10, 5, 2) == "pause", "full pipeline pauses producer")
assert(media["backpressure"](9, 12, 8, 2) == "slow-producer", "near-full pipeline applies pressure")
assert(media["thermal_profile"](91, 80) == "conserve", "thermal safety takes priority")

make sample_a := [1, "cpu.load", 24, "percent", 100]
make sample_b := [2, "cpu.load", 84, "percent", 200]
make sample_c := [3, "cpu.load", 96, "percent", 300]

make empty_gpu_rows := []
make valid_gpu := ["NVIDIA GeForce RTX", "driver-1", 65, 75, 4096, 12288, 180, 2400, 9000]
make gpu_snapshot := ["oplage.gpu-telemetry.v1", "snapshot-1", "2026-11-25T12:00:00Z", "nvidia-smi", "read_only", true, "", false, true, [valid_gpu]]
make unavailable_gpu_snapshot := ["oplage.gpu-telemetry.v1", "snapshot-2", "2026-11-25T12:00:00Z", "nvidia-smi", "read_only", false, "nvidia-smi unavailable", false, true, empty_gpu_rows]
assert(oplage_gpu["gpu_descriptor_valid"](valid_gpu), "OPlague GPU descriptor is bounded")
assert(oplage_gpu["gpu_snapshot_valid"](gpu_snapshot), "normalized OPlague v1 snapshot passes the policy adapter")
assert(oplage_gpu["gpu_snapshot_valid"](unavailable_gpu_snapshot), "explicit unavailable snapshot remains valid")
assert(not oplage_gpu["gpu_snapshot_valid"](["oplage.gpu-telemetry.v1", "snapshot-3", "2026-11-25T12:00:00Z", "nvidia-smi", "read_only", true, "", false, false, [valid_gpu]]), "unverified digest marker is rejected")
assert(not oplage_gpu["gpu_snapshot_valid"](["oplage.gpu-telemetry.v1", "snapshot-4", "2026-11-25T12:00:00Z", "nvidia-smi", "read_only", true, "", true, true, [valid_gpu]]), "sensor export cannot claim device controls")
make gpu_converted := oplage_gpu["gpu_snapshot_samples"](gpu_snapshot, 100, 5000000)
assert(gpu_converted[0] == "ready" and size(gpu_converted[1]) == 7, "supported GPU readings become bounded samples")
assert(gpu_converted[1][0] == [101, "NVIDIA GeForce RTX", "temperature_c", 65, "celsius", 5000000], "sample retains device identity and separate monotonic time")
assert(telemetry["sequence_valid"](gpu_converted[1]), "GPU samples keep monotonic sequence")
make gpu_unknown := ["NVIDIA GeForce RTX", "driver-1", "unknown", 75, 4096, 12288, 180, 2400, 9000]
make gpu_unknown_snapshot := ["oplage.gpu-telemetry.v1", "snapshot-5", "2026-11-25T12:00:00Z", "nvidia-smi", "read_only", true, "", false, true, [gpu_unknown]]
make gpu_unknown_result := oplage_gpu["gpu_snapshot_samples"](gpu_unknown_snapshot, 200, 6000000)
assert(gpu_unknown_result[0] == "ready" and size(gpu_unknown_result[1]) == 6, "unknown sensor values are omitted, not replaced by zero")
assert(oplage_gpu["gpu_snapshot_samples"](unavailable_gpu_snapshot, 0, 7000000)[0] == "unavailable", "unavailable provider emits no readings")
assert(telemetry["sample_valid"](sample_a), "telemetry sample contract")
assert(telemetry["alert_level"](24, 70, 90) == "normal", "telemetry normal band")
assert(telemetry["alert_level"](84, 70, 90) == "warning", "telemetry warning band")
assert(telemetry["alert_level"](96, 70, 90) == "critical", "telemetry critical band")
make window_a := telemetry["append_window"]([], sample_a, 2)
make window_b := telemetry["append_window"](window_a[1], sample_b, 2)
make window_c := telemetry["append_window"](window_b[1], sample_c, 2)
assert(window_c[1] == [sample_b, sample_c], "telemetry history remains bounded")
assert(telemetry["sequence_valid"](window_c[1]), "telemetry sequence is monotonic")

assert(theme["palette_valid"](theme["palette_ratios"]()), "DAK palette proportions")
assert(theme["palette_color"]("navigation") == "#FFD400", "navigation uses Duck yellow")
assert(theme["palette_color"]("alert") == "#FFD400", "alerts use Duck yellow")
assert(theme["motion_profile"](true) == "static", "reduced-motion preference is respected")
assert(motion["frame_state"](15900, 16000, false) == "within-budget", "frame stays within 16 ms budget")
assert(motion["frame_state"](17000, 16000, false) == "late", "late frame is observable")
assert(motion["frame_state"](17000, 16000, true) == "static", "reduced motion takes precedence")

assert(desktop["item_limit"]() == 10, "desktop clutter limit")
assert(desktop["clutter_state"](10) == "clear", "desktop stays clear at the limit")
assert(desktop["clutter_state"](11) == "review", "desktop clutter is surfaced")
assert(desktop["clutter_state"](-1) == "invalid", "negative desktop count is invalid")
assert(desktop["startup_action_valid"]("disable", "current_user"), "user startup can be disabled reversibly")
assert(not desktop["startup_action_valid"]("disable", "machine"), "machine-wide startup changes are denied")
assert(not desktop["startup_action_valid"]("delete", "current_user"), "startup deletion is not an allowed action")
assert(desktop["process_action_valid"]("inspect"), "process inspection is allowed")
assert(not desktop["process_action_valid"]("terminate"), "process termination is outside desktop optimizer")
assert(desktop["file_action_valid"]("move_to_inbox"), "safe file organization is allowed")
assert(not desktop["file_action_valid"]("delete"), "file deletion is not an allowed action")
assert(desktop["background_state"](19, 9) == "normal", "low background use")
assert(desktop["background_state"](25, 4) == "review", "high CPU use is flagged")
assert(desktop["background_state"](4, 11) == "review", "high memory use is flagged")
assert(desktop["background_state"](101, 0) == "invalid", "out-of-range metrics are rejected")


make history_root := [1, 0, "main", "create", "initial"]
make history_row_a := history["append_revision"]([history_root], 2, 1, "main", "edit", "first")
make history_row_b := history["append_revision"](history_row_a[1], 3, 1, "experiment", "branch", "alternate")
assert(history["history_valid"](history_row_b[1]), "branched state history keeps parent links valid")
assert(history_row_b[0] == "appended", "history branch can be appended from an older revision")
assert(history["checkout"](history_row_b[1], 3)[1][2] == "experiment", "time travel checks out the selected branch")
assert(history["append_revision"](history_row_b[1], 5, 4, "main", "edit", "bad")[0] == "missing-parent", "history refuses unknown parents")
assert(history["branch_from"](history_row_b[1], 1, "sandbox") == "ready", "history can branch from a prior state")

assert(workspace["layout_for"]("log.anomaly") == "timeline-diff", "anomaly analysis selects timeline and diff")
assert(workspace["layout_for"]("schema.design") == "schema-canvas", "schema design gets a canvas-first layout")
assert(workspace["focus_valid"]("schema.design", "node-17"), "spatial focus is bound to a real item")

make navigation_history := ["schema.design", "log.anomaly", "schema.design"]
assert(prefetch["prefetch_decision"](navigation_history, "schema.design", 100, 1000) == "warm-cache-only", "predictive prefetch warms cache after repeated intent")
assert(prefetch["prefetch_decision"](navigation_history, "logs.export", 100, 1000) == "skip", "unproven speculation is skipped")
assert(prefetch["prefetch_decision"](navigation_history, "schema.design", 1000, 1000) == "defer", "prefetch respects cache budget")
assert(not prefetch["speculative_effect_allowed"]("write-file"), "speculative execution cannot mutate authoritative data")

make bpm_schema := ["audio.bpm", "number", 40, 240]
assert(config["numeric_schema_valid"](bpm_schema), "visual inspector accepts a valid numeric schema")
assert(config["numeric_value_valid"](bpm_schema, 120), "visual inspector accepts an in-range value")
assert(not config["numeric_value_valid"](bpm_schema, 999), "visual inspector rejects out-of-range values")
assert(config["enum_value_valid"]("dark", ["dark", "light"]), "enum inspector accepts declared values")
assert(not config["enum_value_valid"]("neon", ["dark", "light"]), "enum inspector rejects undeclared values")
assert(config["inspector_feedback"](false) == ["invalid", "commit-denied"], "invalid configuration cannot be committed")

assert(recovery["recovery_mode"](100, 1000, true, true) == "normal", "healthy system remains in normal mode")
assert(recovery["recovery_mode"](950, 1000, true, true) == "reduce-quality-and-snapshot", "memory pressure requests a snapshot and degraded quality")
assert(recovery["recovery_mode"](400, 1000, true, false) == "snapshot-cpu-renderer", "renderer failure falls back to a low-graphics path")
assert(recovery["recovery_mode"](400, 1000, false, true) == "emergency-snapshot-lite", "device failure enters emergency mode")
assert(recovery["restore_policy"](true, false, true) == "quarantine", "corrupt snapshots are quarantined")
assert(recovery["restore_policy"](true, true, false) == "migration-required", "unknown snapshot schemas require migration")

make spring_result := physics["spring_step"](0, 0, 1, 100, 20, 1, 0.01)
assert(spring_result[0] == "stepped" and spring_result[1] > 0 and spring_result[2] > 0, "spring physics preserves motion velocity")
assert(physics["spring_step"](0, 0, 1, 100, 20, 1, 0.5)[0] == "invalid", "spring physics clamps large frame deltas")
assert(not physics["motion_allowed"](true, false), "reduced motion disables spring effects")

assert(palette["intent_provider"]() == "deterministic-fallback", "palette has a local fallback until SLM host is installed")
assert(palette["model_transport_policy"]() == "local-only", "command intent never requires cloud transport")
assert(palette["resolve_intent"]("optimize this node", "graph.node.17") == "graph.optimize-focused-node", "natural language fallback binds intent to the focused node")
assert(palette["resolve_intent"]("optimize this node", "") == "unresolved", "spatial command requires a focused object")

make plugin_grants := ["telemetry.read", "workspace.read"]
make valid_wasm_plugin := ["metrics.panel", "wasm-component", 500, 64, "verified", ["telemetry.read"]]
make unsafe_wasm_plugin := ["metrics.panel", "wasm-component", 500, 64, "verified", ["driver.write"]]
assert(plugin_sandbox["plugin_admission"](valid_wasm_plugin, plugin_grants) == "sandbox-eligible", "bounded Wasm package passes admission policy")
assert(plugin_sandbox["plugin_admission"](unsafe_wasm_plugin, plugin_grants) == "reject", "plugin cannot amplify host capabilities")
assert(plugin_sandbox["host_required"]() == "wasmtime-or-equivalent-component-host", "plugin isolation requires a real component host")

make canvas_caps := ["canvas.dx12", "canvas.metal"]
assert(canvas["choose_canvas_backend"](canvas_caps) == "directx12", "canvas selects the first supported platform backend")
assert(canvas["choose_canvas_backend"]([]) == "cpu-fallback", "canvas has a safe CPU fallback")
assert(canvas["frame_budget_microseconds"](120) > 0, "canvas frame budget is derived from target rate")
assert(canvas["frame_budget_microseconds"](500) == -1, "canvas rejects unsupported frame-rate targets")


make keyboard_event := ["keyboard", "shortcut", "node-17", 40, 80, 0, 0.99, 1000, "local", true]
make voice_event := ["voice", "utterance", "node-17", 40, 80, 0, 0.91, 1030, "local", true]
make remote_voice_event := ["voice", "utterance", "node-17", 40, 80, 0, 0.91, 1030, "remote", true]
make stylus_event := ["stylus", "tap", "node-17", 41, 82, 0.6, 0.96, 1040, "local", true]
assert(spatial_input["input_event_valid"](keyboard_event), "keyboard event passes local spatial admission")
assert(spatial_input["input_event_valid"](voice_event), "opted-in voice event passes local admission")
assert(not spatial_input["input_event_valid"](remote_voice_event), "voice event cannot leave the local privacy boundary")
assert(spatial_input["multimodal_pair_valid"](voice_event, stylus_event, 80), "voice and stylus events can be fused within a bounded time window")
assert(not spatial_input["multimodal_pair_valid"](voice_event, stylus_event, 5), "distant modalities are not combined")
make mismatched_stylus := ["stylus", "tap", "node-22", 41, 82, 0.6, 0.96, 1040, "local", true]
assert(not spatial_input["multimodal_pair_valid"](voice_event, mismatched_stylus, 80), "fusion refuses conflicting spatial targets")
assert(spatial_input["resolve_spatial_intent"](voice_event, "optimize this node", "") == ["dispatch", "graph.optimize-focused-node", "node-17"], "voice command resolves against its screen anchor")
make unanchored_voice := ["voice", "utterance", "", 0, 0, 0, 0.91, 1030, "local", true]
assert(spatial_input["resolve_spatial_intent"](unanchored_voice, "optimize this node", "node-9") == ["dispatch", "graph.optimize-focused-node", "node-9"], "voice command can bind to the focused node")
make weak_voice := ["voice", "utterance", "node-17", 0, 0, 0, 0.2, 1030, "local", true]
assert(spatial_input["resolve_spatial_intent"](weak_voice, "optimize this node", "") == ["reject", "low-intent-confidence"], "low-confidence spatial commands are rejected")
make no_consent_voice := ["voice", "utterance", "node-17", 0, 0, 0, 0.9, 1030, "local", false]
assert(not spatial_input["input_event_valid"](no_consent_voice), "microphone intents require explicit opt-in")
emit "DAK_REAPER_CONTRACTS_OK"


# DAK native-system-service contracts. These prove policy decisions only.
# They do not write disks, install packages, map drivers or activate boot slots.

make install_target := ["disk0", "x86_64", 1000000, 512, "uefi", true]
make install_target_no_consent := ["disk0", "x86_64", 1000000, 512, "uefi", false]
assert(installer["target_valid"](install_target), "installer accepts a bounded x86_64 UEFI target")
assert(not installer["target_valid"](["", "x86_64", 1000000, 512, "uefi", true]), "installer rejects an unnamed disk")
assert(installer["admission"](install_target, "verified", "ready") == "admit-plan-only", "installer admits only a verified, recoverable plan")
assert(installer["admission"](install_target_no_consent, "verified", "ready") == "reject-consent", "installer requires explicit destructive-operation consent")
assert(installer["admission"](install_target, "unverified", "ready") == "reject-source-trust", "installer rejects an unverified source")
assert(installer["admission"](install_target, "verified", "missing") == "reject-recovery", "installer requires a recovery path")

make install_layout := [
    ["efi", "efi", 4096, 4096],
    ["system_a", "system", 8192, 131072],
    ["system_b", "system", 139264, 131072],
    ["recovery", "recovery", 270336, 65536]
]
make overlapping_layout := [
    ["efi", "efi", 4096, 4096],
    ["system_a", "system", 8192, 131072],
    ["system_b", "system", 102400, 131072],
    ["recovery", "recovery", 270336, 65536]
]
assert(installer["layout_valid"](install_layout, 1000000), "installer accepts ordered non-overlapping A/B and recovery partitions")
assert(not installer["layout_valid"](overlapping_layout, 1000000), "installer rejects overlapping partitions")
assert(installer["transition_valid"]("planned", "validated"), "installer advances a validated plan")
assert(not installer["transition_valid"]("planned", "committed"), "installer cannot skip staging and boot verification")
assert(installer["commit_policy"]("ready_to_commit", true, true, true, true) == "commit-plan-only", "installer requires all commit gates")
assert(installer["commit_policy"]("ready_to_commit", true, true, true, false) == "reject-boot-unverified", "installer refuses an unverified boot result")

make driver_device := ["nvme0", "pci", 4096, 256, 11, true]
make verified_driver := ["nvme.sample", 1, "pci", "x86_64", ["read.device"], "Ivan-VHS", "verified", 65536]
make unverified_driver := ["nvme.sample", 1, "pci", "x86_64", ["read.device"], "Ivan-VHS", "unverified", 65536]
make wrong_bus_driver := ["nvme.sample", 1, "usb", "x86_64", ["read.device"], "Ivan-VHS", "verified", 65536]
make driver_grants := ["read.device"]
assert(driver_runtime["admission"](verified_driver, driver_device, "x86_64", 1, ["pci", "usb"], driver_grants) == "admit-isolated-plan-only", "driver admission requires verified provenance and least authority")
assert(driver_runtime["admission"](unverified_driver, driver_device, "x86_64", 1, ["pci", "usb"], driver_grants) == "reject-signature", "driver runtime rejects unverified signatures")
assert(driver_runtime["admission"](wrong_bus_driver, driver_device, "x86_64", 1, ["pci", "usb"], driver_grants) == "reject-device-match", "driver runtime rejects a bus mismatch")
assert(driver_runtime["transition_valid"]("verified", "admitted"), "driver runtime advances verified metadata")
assert(not driver_runtime["transition_valid"]("candidate", "running"), "driver runtime cannot jump directly to execution")
assert(driver_runtime["unload_policy"]("running", true, true, true) == "unload-plan-only", "driver unload requires quiesced IRQ and DMA")
assert(driver_runtime["unload_policy"]("running", true, false, true) == "reject-dma-active", "driver unload refuses active DMA")

make installed_ids := ["lib.core", "shell.base"]
make app_package := ["example.app", 1, 0, 0, "x86_64", 1, "application", ["lib.core"], ["fs.read"], "verified", 1048576]
make unsigned_package := ["example.app", 1, 0, 0, "x86_64", 1, "application", ["lib.core"], ["fs.read"], "unverified", 1048576]
assert(packages["package_valid"](app_package), "package manager accepts a bounded package manifest")
assert(not packages["package_valid"](["", 1, 0, 0, "x86_64", 1, "application", [], [], "verified", 1048576]), "package manager rejects an empty package identity")
assert(packages["dependencies_satisfied"](["lib.core"], installed_ids), "package manager resolves installed dependencies")
assert(not packages["dependencies_satisfied"](["missing.lib"], installed_ids), "package manager rejects missing dependencies")
assert(packages["paths_valid"]([["usr", "bin", "example"], ["usr", "share", "example"]]), "package manager accepts safe relative payload paths")
assert(not packages["paths_valid"]([["usr", "..", "system"]]), "package manager rejects parent traversal in payload paths")
assert(packages["admission"](app_package, "x86_64", 1, installed_ids) == "admit-transaction-plan-only", "package manager admits a verified dependency-complete plan")
assert(packages["admission"](unsigned_package, "x86_64", 1, installed_ids) == "reject-signature", "package manager rejects unverified package provenance")
assert(packages["transition_valid"]("resolved", "staged"), "package transaction may stage after dependency resolution")
assert(not packages["transition_valid"]("planned", "committed"), "package transaction cannot skip verification and staging")
assert(packages["remove_policy"]("installed", 0, false) == "remove-plan-only", "package removal is allowed only as a plan")
assert(packages["remove_policy"]("installed", 1, false) == "reject-dependents", "package manager protects active dependents")
assert(packages["remove_policy"]("installed", 0, true) == "reject-protected", "package manager protects system packages")

make update_manifest := ["stable", 1, 1, 0, "x86_64", 2, 10485760, "sha256:payload", "DAK Release", "verified"]
make downgrade_manifest := ["stable", 0, 9, 0, "x86_64", 3, 10485760, "sha256:payload", "DAK Release", "verified"]
make unsigned_update := ["stable", 1, 1, 0, "x86_64", 2, 10485760, "sha256:payload", "DAK Release", "unverified"]
assert(updates["manifest_valid"](update_manifest), "update manager accepts a bounded signed manifest")
assert(updates["admission"](update_manifest, "x86_64", [1, 0, 0], 1) == "stage-inactive-slot-plan-only", "update manager stages a newer verified image")
assert(updates["admission"](downgrade_manifest, "x86_64", [1, 0, 0], 1) == "reject-downgrade", "update manager rejects version rollback")
assert(updates["admission"](unsigned_update, "x86_64", [1, 0, 0], 1) == "reject-signature", "update manager rejects unverified update signatures")
assert(updates["inactive_slot"]("A") == "B", "A/B update targets the inactive B slot")
assert(updates["inactive_slot"]("B") == "A", "A/B update targets the inactive A slot")
assert(updates["inactive_slot"]("unknown") == "", "A/B update rejects an unknown active slot")
assert(updates["transition_valid"]("staged", "armed"), "update manager arms only a staged payload")
assert(not updates["transition_valid"]("staged", "confirmed"), "update manager requires a successful boot before confirmation")
assert(updates["boot_result_policy"]("healthy", 1, 3) == "confirm-plan-only", "update manager confirms only a healthy boot")
assert(updates["boot_result_policy"]("failed", 3, 3) == "rollback-plan-only", "update manager rolls back after the bounded retry limit")
assert(updates["boot_result_policy"]("pending", 1, 3) == "await-confirmation", "update manager waits for explicit boot confirmation")
