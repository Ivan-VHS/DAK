# DuckOS integration contract suite.
# Run with Reaper's tree-walk engine and VM.

import "duckos/kernel/boot.rpr" as boot
import "duckos/kernel/memory.rpr" as memory
import "duckos/kernel/arena.rpr" as arena
import "duckos/kernel/scheduler.rpr" as scheduler
import "duckos/kernel/flock.rpr" as flock
import "duckos/kernel/ipc.rpr" as ipc
import "duckos/kernel/zero_copy_bus.rpr" as bus
import "duckos/security/capabilities.rpr" as capabilities
import "duckos/security/trust.rpr" as trust
import "duckos/drivers/abi.rpr" as drivers
import "duckos/drivers/orchestrator.rpr" as orchestrator
import "duckos/services/supervisor.rpr" as supervisor
import "duckos/storage/hypergraph.rpr" as storage
import "duckos/storage/crdt.rpr" as crdt
import "duckos/system/three_media.rpr" as media
import "duckos/system/telemetry.rpr" as telemetry
import "duckos/gpu/oplage_bridge.rpr" as oplage_gpu
import "duckos/ui/theme.rpr" as theme
import "duckos/ui/motion.rpr" as motion
import "duckos/storage/history.rpr" as history
import "duckos/ui/workspace.rpr" as workspace
import "duckos/system/prefetch.rpr" as prefetch
import "duckos/ui/config.rpr" as config
import "duckos/system/recovery.rpr" as recovery
import "duckos/ui/physics.rpr" as physics
import "duckos/ui/command_palette.rpr" as palette
import "duckos/security/plugin_sandbox.rpr" as plugin_sandbox
import "duckos/ui/canvas.rpr" as canvas
import "duckos/input/spatial.rpr" as spatial_input
import "duckos/ui/desktop.rpr" as desktop
import "duckos/ui/shell_policy.rpr" as shell_policy
import "duckos/ui/window_manager.rpr" as window_manager
import "duckos/ui/taskbar.rpr" as taskbar
import "duckos/ui/notifications.rpr" as notifications
import "duckos/ui/session.rpr" as session
import "duckos/security/desktop_sandbox.rpr" as desktop_sandbox
import "duckos/ui/native_bridge.rpr" as native_bridge

make phases := ["reset", "firmware", "memory", "interrupts", "scheduler", "ipc", "drivers", "services", "desktop"]
assert(boot["sequence_valid"](phases), "boot phases must remain ordered")
assert(boot["transition_valid"]("memory", "interrupts"), "memory must precede interrupt setup")
assert(not boot["transition_valid"]("drivers", "scheduler"), "boot must reject skipped phases")
assert(boot["failure_action"](0) == "continue", "successful phase must continue")
assert(boot["failure_action"](1) == "recovery", "failed phase must enter recovery")

assert(memory["align_up"](17, 16) == 32, "arena alignment")
assert(memory["align_up"](32, 16) == 32, "aligned address must remain unchanged")
assert(memory["align_up"](9223372036854775800, 16) == -1, "alignment must reject signed address overflow")
assert(memory["region_fits"](4096, 1024, 8192, 4096), "valid aligned region")
assert(not memory["region_fits"](4097, 1024, 8192, 4096), "unaligned region must be rejected")
assert(memory["ranges_overlap"](100, 40, 120, 10), "overlapping ranges")
assert(not memory["ranges_overlap"](100, 20, 120, 10), "adjacent ranges do not overlap")
assert(memory["ranges_overlap"](9223372036854775800, 10, 9223372036854775805, 1), "overlap check must avoid end-address overflow")
assert(not memory["ranges_overlap"](-1, 5, 1, 2), "negative physical addresses must be rejected")
assert(memory["arena_reserve"](100, 20, 256, 16) == [132, true], "bounded arena reservation")
assert(memory["arena_reserve"](240, 32, 256, 16) == [240, false], "arena must reject overflow")

make frame := arena["create"](4096, 8192)
assert(frame == ["ready", [4096, 4096, 8192, 0]], "frame arena starts at its aligned base")
make first_frame_allocation := arena["reserve"](frame[1], 100)
assert(first_frame_allocation == ["reserved", [4096, 4196, 8192, 0], 4096], "frame arena reserves an aligned span")
make reset_frame := arena["reset"](first_frame_allocation[1])
assert(reset_frame == ["reset", [4096, 4096, 8192, 1]], "frame arena resets in constant-size state")
assert(arena["soa_layout"](17, 4, 8, 128) == ["ready", 24, 96, 7], "SoA lanes are padded to vector width")
assert(arena["soa_layout"](17, 4, 8, 64)[0] == "over-budget", "SoA layout respects the declared budget")

make tasks := [
    ["idle", 0, 100, "ready"],
    ["audio", 8, 40, "ready"],
    ["desktop", 8, 30, "ready"],
    ["blocked", 99, 1, "blocked"]
]
assert(scheduler["pick_ready"](tasks) == "desktop", "scheduler priority/deadline ordering")
assert(scheduler["pick_ready"]([["sleeping", 7, 1, "blocked"]]) == "", "blocked task must not run")
make workers := [["cpu0", 8, 10, true], ["cpu1", 1, 4, true], ["offline", 0, 64, false]]
assert(flock["choose_worker"](workers, 1) == ["assigned", "cpu1", 2], "flock chooses the least-loaded eligible worker")
assert(flock["choose_worker"]([["full", 4, 4, true]], 1) == ["backpressure", "", 0], "flock refuses a saturated worker")

make sent := ipc["send"]([1, 2], 3, 3)
assert(sent == ["sent", [1, 2, 3]], "queue accepts data below capacity")
make full := ipc["send"]([1, 2], 2, 3)
assert(full == ["backpressure", [1, 2]], "full queue must remain unchanged")
assert(ipc["receive"]([]) == ["empty", [], nothing], "empty receive")
assert(ipc["receive"]([4, 5]) == ["received", [5], 4], "FIFO receive order")

make shared_bus := bus["create"](1024, 75)
make published_a := bus["publish"](shared_bus[1], 512)
make published_b := bus["publish"](published_a[1], 256)
assert(published_a == ["published", [1024, 512, 1, 0, 75], 1], "bus publication reserves bounded capacity")
assert(bus["pressured"](published_b[1]), "bus raises pressure at its high watermark")
assert(bus["publish"](published_b[1], 300)[0] == "backpressure", "bus refuses a payload larger than remaining capacity")
make consumed := bus["consume"](published_b[1], 256)
assert(consumed == ["consumed", [1024, 512, 2, 1, 75]], "consumer releases accounted bytes")

make grants := ["read.device", "telemetry.publish", "memory.map", "sanitize"]
assert(capabilities["permits"](grants, "read.device"), "declared capability is available")
assert(not capabilities["permits"](grants, "write.firmware"), "undeclared capability is denied")
assert(capabilities["child_is_subset"](grants, ["read.device"]), "child may retain a subset")
assert(not capabilities["child_is_subset"](grants, ["read.device", "write.firmware"]), "child cannot amplify authority")
assert(trust["promote"]("untrusted", true) == "validated", "validated input may leave the untrusted state")
assert(trust["promote"]("untrusted", false) == "quarantined", "failed validation enters quarantine")
assert(not trust["effect_allowed"]("untrusted", grants, "read.device"), "untrusted data cannot exercise device access")
assert(trust["effect_allowed"]("untrusted", grants, "sanitize"), "untrusted data may only cross the sanitizer boundary")
assert(trust["effect_allowed"]("validated", grants, "read.device"), "validated data still requires a granted capability")

make valid_driver := ["nvme.sample", 1, "pci", ["read.device", "memory.map"]]
make bad_driver := ["unknown.sample", 2, "mystery", ["write.firmware"]]
make privileged_driver := ["flash.writer", 1, "pci", ["write.firmware"]]
assert(drivers["descriptor_valid"](valid_driver, 1, ["pci", "usb", "acpi"]), "valid driver descriptor")
assert(not drivers["descriptor_valid"](bad_driver, 1, ["pci", "usb", "acpi"]), "unsupported descriptor rejected")
assert(drivers["load_policy"](valid_driver, 1, ["pci", "usb"], grants) == "descriptor-approved", "driver policy accepts declared safe descriptor")
assert(drivers["load_policy"](privileged_driver, 1, ["pci", "usb"], grants) == "reject", "driver cannot request an ungranted capability")
assert(drivers["load_policy"](bad_driver, 1, ["pci", "usb"], grants) == "reject", "driver policy rejects unsafe descriptor")

make device_a := ["nvme0", "pci", 4096, 256, 11, true]
make device_b := ["gpu0", "pci", 4200, 128, 11, false]
make device_c := ["audio0", "usb", 8192, 256, 5, false]
assert(orchestrator["device_valid"](device_a), "device descriptor shape")
assert(orchestrator["resources_conflict"](device_a, device_b), "overlapping device resources are reported")
assert(not orchestrator["resources_conflict"](device_a, device_c), "independent device resources do not conflict")
make signed_package := ["nvme.safe", 1, "pci", "x86_64", ["read.device"], true]
make unsigned_package := ["nvme.unsigned", 1, "pci", "x86_64", ["read.device"], false]
make wrong_arch_package := ["nvme.arm", 1, "pci", "aarch64", ["read.device"], true]
assert(orchestrator["package_policy"](signed_package, device_a, "x86_64", 1, ["pci", "usb"], grants) == "approved", "signed package descriptor passes policy")
assert(orchestrator["package_policy"](unsigned_package, device_a, "x86_64", 1, ["pci", "usb"], grants) == "reject", "unsigned package is rejected")
assert(orchestrator["package_policy"](wrong_arch_package, device_a, "x86_64", 1, ["pci", "usb"], grants) == "reject", "package for a different architecture is rejected")

assert(supervisor["decide"](0, 0, 3) == ["stopped", 0], "clean stop is not restarted")
assert(supervisor["decide"](1, 1, 3) == ["restart", 2], "crashed service receives bounded retry")
assert(supervisor["decide"](1, 3, 3) == ["failed", 3], "restart budget is finite")

make known := ["blake3:aaa", "blake3:bbb"]
assert(storage["node_valid"](["blake3:ccc", "record", ["blake3:aaa"]], known), "graph node may reference known content")
make no_dependencies := []
assert(not storage["node_valid"](["blake3:aaa", "record", no_dependencies], known), "known hash cannot be reused as a new node")
assert(not storage["node_valid"](["blake3:ddd", "record", ["blake3:missing"]], known), "unknown dependency is rejected")
make journal := storage["journal_append"]([], "boot.started", "firmware")
make journal2 := storage["journal_append"](journal, "memory.ready", "arena0")
assert(storage["journal_valid"](journal2), "event journal sequence")
assert(not storage["journal_valid"]([[2, "bad.sequence", "x"]]), "event journal rejects gaps")
make register_left := ["old", 4, "actor-a"]
make register_right := ["new", 5, "actor-b"]
assert(crdt["merge_register"](register_left, register_right) == register_right, "CRDT merge chooses the newer Lamport value")
assert(crdt["merge_register"](register_right, register_left) == register_right, "CRDT merge is independent of arrival order")
assert(crdt["merge_register"](["alpha", 7, "actor-a"], ["zeta", 7, "actor-b"]) == ["alpha", 7, "actor-a"], "actor id breaks equal-clock ties")
assert(crdt["merge_register"](["alpha", 7, "actor-a"], ["zeta", 7, "actor-a"]) == ["zeta", 7, "actor-a"], "canonical value text breaks duplicate actor ties")

assert(media["choose_medium"](512, 2, true, true) == "land", "small scalar work stays on CPU")
assert(media["choose_medium"](4096, 16, true, false) == "water", "dense batch may select accelerator")
assert(media["choose_medium"](9000, 4, false, true) == "sky", "large batch may select node mesh")
assert(media["backpressure"](10, 10, 5, 2) == "pause", "full pipeline pauses producer")
assert(media["backpressure"](9, 12, 8, 2) == "slow-producer", "near-full pipeline applies pressure")
assert(media["thermal_profile"](91, 80) == "conserve", "thermal safety takes priority")

make sample_a := [1, "cpu.load", 24, "percent", 100]
make sample_b := [2, "cpu.load", 84, "percent", 200]
make sample_c := [3, "cpu.load", 96, "percent", 300]

make empty_gpu_rows := []
make valid_gpu := ["NVIDIA GeForce RTX", "driver-1", 65, 75, 4096, 12288, 180, 2400, 9000]
make gpu_snapshot := ["oplage.gpu-telemetry.v1", "snapshot-1", "2026-11-25T12:00:00Z", "nvidia-smi", "read_only", true, "", false, true, [valid_gpu]]
make unavailable_gpu_snapshot := ["oplage.gpu-telemetry.v1", "snapshot-2", "2026-11-25T12:00:00Z", "nvidia-smi", "read_only", false, "nvidia-smi unavailable", false, true, empty_gpu_rows]
assert(oplage_gpu["gpu_descriptor_valid"](valid_gpu), "OPlague GPU descriptor is bounded")
assert(oplage_gpu["gpu_snapshot_valid"](gpu_snapshot), "normalized OPlague v1 snapshot passes the policy adapter")
assert(oplage_gpu["gpu_snapshot_valid"](unavailable_gpu_snapshot), "explicit unavailable snapshot remains valid")
assert(not oplage_gpu["gpu_snapshot_valid"](["oplage.gpu-telemetry.v1", "snapshot-3", "2026-11-25T12:00:00Z", "nvidia-smi", "read_only", true, "", false, false, [valid_gpu]]), "unverified digest marker is rejected")
assert(not oplage_gpu["gpu_snapshot_valid"](["oplage.gpu-telemetry.v1", "snapshot-4", "2026-11-25T12:00:00Z", "nvidia-smi", "read_only", true, "", true, true, [valid_gpu]]), "sensor export cannot claim device controls")
make gpu_converted := oplage_gpu["gpu_snapshot_samples"](gpu_snapshot, 100, 5000000)
assert(gpu_converted[0] == "ready" and size(gpu_converted[1]) == 7, "supported GPU readings become bounded samples")
assert(gpu_converted[1][0] == [101, "NVIDIA GeForce RTX", "temperature_c", 65, "celsius", 5000000], "sample retains device identity and separate monotonic time")
assert(telemetry["sequence_valid"](gpu_converted[1]), "GPU samples keep monotonic sequence")
make gpu_unknown := ["NVIDIA GeForce RTX", "driver-1", "unknown", 75, 4096, 12288, 180, 2400, 9000]
make gpu_unknown_snapshot := ["oplage.gpu-telemetry.v1", "snapshot-5", "2026-11-25T12:00:00Z", "nvidia-smi", "read_only", true, "", false, true, [gpu_unknown]]
make gpu_unknown_result := oplage_gpu["gpu_snapshot_samples"](gpu_unknown_snapshot, 200, 6000000)
assert(gpu_unknown_result[0] == "ready" and size(gpu_unknown_result[1]) == 6, "unknown sensor values are omitted, not replaced by zero")
assert(oplage_gpu["gpu_snapshot_samples"](unavailable_gpu_snapshot, 0, 7000000)[0] == "unavailable", "unavailable provider emits no readings")
assert(telemetry["sample_valid"](sample_a), "telemetry sample contract")
assert(telemetry["alert_level"](24, 70, 90) == "normal", "telemetry normal band")
assert(telemetry["alert_level"](84, 70, 90) == "warning", "telemetry warning band")
assert(telemetry["alert_level"](96, 70, 90) == "critical", "telemetry critical band")
make window_a := telemetry["append_window"]([], sample_a, 2)
make window_b := telemetry["append_window"](window_a[1], sample_b, 2)
make window_c := telemetry["append_window"](window_b[1], sample_c, 2)
assert(window_c[1] == [sample_b, sample_c], "telemetry history remains bounded")
assert(telemetry["sequence_valid"](window_c[1]), "telemetry sequence is monotonic")

assert(theme["palette_valid"](theme["palette_ratios"]()), "DAK palette proportions")
assert(theme["palette_color"]("page") == "#050505", "DAK uses the Imperial Noir canvas")
assert(theme["palette_color"]("focus") == "#FFE6A3", "DAK uses warm gold focus feedback")
assert(theme["palette_color"]("navigation") == "#FFD700", "navigation uses DAK gold")
assert(theme["palette_color"]("alert") == "#FFD700", "alerts use DAK gold")
assert(theme["status_color"]("success") == "#22C55E", "success uses semantic status green")
assert(theme["status_color"]("danger") == "#EF4444", "danger uses semantic status red")
assert(theme["status_color"]("info") == "#3B82F6", "information uses semantic status blue")
assert(not theme["role_valid"]("alert"), "legacy alert alias is not a semantic palette role")
assert(theme["theme_mode_valid"]("high-contrast"), "high-contrast theme mode is supported")
assert(theme["token_allowed"]("accent", "#FFD700"), "approved accent token is accepted")
assert(theme["token_allowed"]("danger", "#EF4444"), "approved danger status token is accepted")
assert(not theme["token_allowed"]("accent", "#00FF00"), "arbitrary accent colors are rejected")
assert(theme["text_pair_valid"]("text-primary", "page"), "primary text is allowed on the page surface")
assert(not theme["text_pair_valid"]("text-primary", "accent"), "accent is not a default text background")
assert(theme["motion_profile"](true) == "static", "reduced-motion preference is respected")
assert(motion["frame_state"](15900, 16000, false) == "within-budget", "frame stays within 16 ms budget")
assert(motion["frame_state"](17000, 16000, false) == "late", "late frame is observable")
assert(motion["frame_state"](17000, 16000, true) == "static", "reduced motion takes precedence")

assert(desktop["item_limit"]() == 10, "desktop clutter limit")
assert(desktop["clutter_state"](10) == "clear", "desktop stays clear at the limit")
assert(desktop["clutter_state"](11) == "review", "desktop clutter is surfaced")
assert(desktop["clutter_state"](-1) == "invalid", "negative desktop count is invalid")
assert(desktop["startup_action_valid"]("disable", "current_user"), "user startup can be disabled reversibly")
assert(not desktop["startup_action_valid"]("disable", "machine"), "machine-wide startup changes are denied")
assert(not desktop["startup_action_valid"]("delete", "current_user"), "startup deletion is not an allowed action")
assert(desktop["process_action_valid"]("inspect"), "process inspection is allowed")
assert(not desktop["process_action_valid"]("terminate"), "process termination is outside desktop optimizer")
assert(desktop["file_action_valid"]("move_to_inbox"), "safe file organization is allowed")
assert(not desktop["file_action_valid"]("delete"), "file deletion is not an allowed action")
assert(desktop["background_state"](19, 9) == "normal", "low background use")
assert(desktop["background_state"](25, 4) == "review", "high CPU use is flagged")
assert(desktop["background_state"](4, 11) == "review", "high memory use is flagged")
assert(desktop["background_state"](101, 0) == "invalid", "out-of-range metrics are rejected")


assert(shell_policy["workspace_id_valid"]("engineering"), "engineering workspace is supported")
assert(not shell_policy["workspace_id_valid"]("root"), "unknown workspace is rejected")
assert(shell_policy["density_profile_valid"]("compact"), "compact density is supported")
assert(not shell_policy["density_profile_valid"]("tiny"), "unknown density is rejected")
assert(shell_policy["window_mode_valid"]("floating"), "floating window mode is supported")
assert(not shell_policy["window_mode_valid"]("detached"), "unknown window mode is rejected")
assert(shell_policy["window_action_valid"]("focus", "user_session"), "focus stays inside the user session")
assert(not shell_policy["window_action_valid"]("focus", "machine"), "machine scope is denied")
assert(not shell_policy["window_action_valid"]("delete", "user_session"), "unknown window actions are denied")
assert(shell_policy["window_placement_valid"](0, 0, 640, 480, 1920, 1080), "bounded window geometry is accepted")
assert(not shell_policy["window_placement_valid"](-1, 0, 640, 480, 1920, 1080), "negative window coordinates are rejected")
assert(not shell_policy["window_placement_valid"](0, 0, 2000, 480, 1920, 1080), "oversized window geometry is rejected")
assert(shell_policy["window_count_valid"](8, 16), "window count stays inside its cap")
assert(not shell_policy["window_count_valid"](17, 16), "window count over the cap is rejected")
assert(shell_policy["focus_target_valid"](true, true, true), "focus requires a visible enabled target")
assert(not shell_policy["focus_target_valid"](true, false, true), "hidden windows cannot receive focus")
make valid_desktop_session := ["dak.session.v1", "main", "standard", 3, "poi", false, false]
make invalid_desktop_session := ["dak.session.v1", "main", "standard", 17, "poi", false, false]
assert(shell_policy["session_snapshot_valid"](valid_desktop_session), "versioned desktop session is accepted")
assert(not shell_policy["session_snapshot_valid"](invalid_desktop_session), "invalid session snapshot is rejected")
assert(shell_policy["layout_for"]("engineering") == "editor-diagnostics-inspector", "engineering workspace selects its task layout")

make history_root := [1, 0, "main", "create", "initial"]
make history_row_a := history["append_revision"]([history_root], 2, 1, "main", "edit", "first")
make history_row_b := history["append_revision"](history_row_a[1], 3, 1, "experiment", "branch", "alternate")
assert(history["history_valid"](history_row_b[1]), "branched state history keeps parent links valid")
assert(history_row_b[0] == "appended", "history branch can be appended from an older revision")
assert(history["checkout"](history_row_b[1], 3)[1][2] == "experiment", "time travel checks out the selected branch")
assert(history["append_revision"](history_row_b[1], 5, 4, "main", "edit", "bad")[0] == "missing-parent", "history refuses unknown parents")
assert(history["branch_from"](history_row_b[1], 1, "sandbox") == "ready", "history can branch from a prior state")

assert(workspace["layout_for"]("log.anomaly") == "timeline-diff", "anomaly analysis selects timeline and diff")
assert(workspace["layout_for"]("schema.design") == "schema-canvas", "schema design gets a canvas-first layout")
assert(workspace["focus_valid"]("schema.design", "node-17"), "spatial focus is bound to a real item")

make navigation_history := ["schema.design", "log.anomaly", "schema.design"]
assert(prefetch["prefetch_decision"](navigation_history, "schema.design", 100, 1000) == "warm-cache-only", "predictive prefetch warms cache after repeated intent")
assert(prefetch["prefetch_decision"](navigation_history, "logs.export", 100, 1000) == "skip", "unproven speculation is skipped")
assert(prefetch["prefetch_decision"](navigation_history, "schema.design", 1000, 1000) == "defer", "prefetch respects cache budget")
assert(not prefetch["speculative_effect_allowed"]("write-file"), "speculative execution cannot mutate authoritative data")

make bpm_schema := ["audio.bpm", "number", 40, 240]
assert(config["numeric_schema_valid"](bpm_schema), "visual inspector accepts a valid numeric schema")
assert(config["numeric_value_valid"](bpm_schema, 120), "visual inspector accepts an in-range value")
assert(not config["numeric_value_valid"](bpm_schema, 999), "visual inspector rejects out-of-range values")
assert(config["enum_value_valid"]("dark", ["dark", "light"]), "enum inspector accepts declared values")
assert(not config["enum_value_valid"]("neon", ["dark", "light"]), "enum inspector rejects undeclared values")
assert(config["inspector_feedback"](false) == ["invalid", "commit-denied"], "invalid configuration cannot be committed")

assert(recovery["recovery_mode"](100, 1000, true, true) == "normal", "healthy system remains in normal mode")
assert(recovery["recovery_mode"](950, 1000, true, true) == "reduce-quality-and-snapshot", "memory pressure requests a snapshot and degraded quality")
assert(recovery["recovery_mode"](400, 1000, true, false) == "snapshot-cpu-renderer", "renderer failure falls back to a low-graphics path")
assert(recovery["recovery_mode"](400, 1000, false, true) == "emergency-snapshot-lite", "device failure enters emergency mode")
assert(recovery["restore_policy"](true, false, true) == "quarantine", "corrupt snapshots are quarantined")
assert(recovery["restore_policy"](true, true, false) == "migration-required", "unknown snapshot schemas require migration")

make spring_result := physics["spring_step"](0, 0, 1, 100, 20, 1, 0.01)
assert(spring_result[0] == "stepped" and spring_result[1] > 0 and spring_result[2] > 0, "spring physics preserves motion velocity")
assert(physics["spring_step"](0, 0, 1, 100, 20, 1, 0.5)[0] == "invalid", "spring physics clamps large frame deltas")
assert(not physics["motion_allowed"](true, false), "reduced motion disables spring effects")

assert(palette["intent_provider"]() == "deterministic-fallback", "palette has a local fallback until SLM host is installed")
assert(palette["model_transport_policy"]() == "local-only", "command intent never requires cloud transport")
assert(palette["resolve_intent"]("optimize this node", "graph.node.17") == "graph.optimize-focused-node", "natural language fallback binds intent to the focused node")
assert(palette["resolve_intent"]("optimize this node", "") == "unresolved", "spatial command requires a focused object")

make plugin_grants := ["telemetry.read", "workspace.read"]
make valid_wasm_plugin := ["metrics.panel", "wasm-component", 500, 64, "verified", ["telemetry.read"]]
make unsafe_wasm_plugin := ["metrics.panel", "wasm-component", 500, 64, "verified", ["driver.write"]]
assert(plugin_sandbox["plugin_admission"](valid_wasm_plugin, plugin_grants) == "sandbox-eligible", "bounded Wasm package passes admission policy")
assert(plugin_sandbox["plugin_admission"](unsafe_wasm_plugin, plugin_grants) == "reject", "plugin cannot amplify host capabilities")
assert(plugin_sandbox["host_required"]() == "wasmtime-or-equivalent-component-host", "plugin isolation requires a real component host")

make canvas_caps := ["canvas.dx12", "canvas.metal"]
assert(canvas["choose_canvas_backend"](canvas_caps) == "directx12", "canvas selects the first supported platform backend")
assert(canvas["choose_canvas_backend"]([]) == "cpu-fallback", "canvas has a safe CPU fallback")
assert(canvas["frame_budget_microseconds"](120) > 0, "canvas frame budget is derived from target rate")
assert(canvas["frame_budget_microseconds"](500) == -1, "canvas rejects unsupported frame-rate targets")


make keyboard_event := ["keyboard", "shortcut", "node-17", 40, 80, 0, 0.99, 1000, "local", true]
make voice_event := ["voice", "utterance", "node-17", 40, 80, 0, 0.91, 1030, "local", true]
make remote_voice_event := ["voice", "utterance", "node-17", 40, 80, 0, 0.91, 1030, "remote", true]
make stylus_event := ["stylus", "tap", "node-17", 41, 82, 0.6, 0.96, 1040, "local", true]
assert(spatial_input["input_event_valid"](keyboard_event), "keyboard event passes local spatial admission")
assert(spatial_input["input_event_valid"](voice_event), "opted-in voice event passes local admission")
assert(not spatial_input["input_event_valid"](remote_voice_event), "voice event cannot leave the local privacy boundary")
assert(spatial_input["multimodal_pair_valid"](voice_event, stylus_event, 80), "voice and stylus events can be fused within a bounded time window")
assert(not spatial_input["multimodal_pair_valid"](voice_event, stylus_event, 5), "distant modalities are not combined")
make mismatched_stylus := ["stylus", "tap", "node-22", 41, 82, 0.6, 0.96, 1040, "local", true]
assert(not spatial_input["multimodal_pair_valid"](voice_event, mismatched_stylus, 80), "fusion refuses conflicting spatial targets")
assert(spatial_input["resolve_spatial_intent"](voice_event, "optimize this node", "") == ["dispatch", "graph.optimize-focused-node", "node-17"], "voice command resolves against its screen anchor")
make unanchored_voice := ["voice", "utterance", "", 0, 0, 0, 0.91, 1030, "local", true]
assert(spatial_input["resolve_spatial_intent"](unanchored_voice, "optimize this node", "node-9") == ["dispatch", "graph.optimize-focused-node", "node-9"], "voice command can bind to the focused node")
make weak_voice := ["voice", "utterance", "node-17", 0, 0, 0, 0.2, 1030, "local", true]
assert(spatial_input["resolve_spatial_intent"](weak_voice, "optimize this node", "") == ["reject", "low-intent-confidence"], "low-confidence spatial commands are rejected")
make no_consent_voice := ["voice", "utterance", "node-17", 0, 0, 0, 0.9, 1030, "local", false]
assert(not spatial_input["input_event_valid"](no_consent_voice), "microphone intents require explicit opt-in")
# Reaper-first desktop policy core: deterministic decisions, not native enforcement.
make main_window := [1, 42, 0, "floating", 100, 80, 800, 600, 20, true, true, false]
make system_modal := [2, 1, 0, "dialog", 200, 150, 480, 300, 1000000, true, true, true]
make desktop_bounds := [0, 0, 1920, 1080]
assert(window_manager["descriptor_valid"](main_window), "window descriptor is valid")
assert(not window_manager["descriptor_valid"]([1, 42]), "short window descriptor is rejected")
assert(window_manager["geometry_within_bounds"](main_window, desktop_bounds), "window geometry is contained by the display")
assert(not window_manager["descriptor_valid"]("malformed-window"), "non-list window input is rejected")
assert(not window_manager["descriptor_valid"]([1, "bad-pid", 0, "floating", 0, 0, 400, 300, 1, true, true, false]), "wrongly typed process identifier is rejected")
assert(window_manager["focus_decision"](main_window, 0, false) == "allow-policy-only", "visible focusable window may receive focus")
assert(window_manager["focus_decision"](main_window, 2, false) == "deny-modal-block", "active modal blocks unrelated user focus")
assert(window_manager["z_order_decision"](main_window, 1000000, false) == "user-layer", "user window stays below reserved system layers")
assert(window_manager["z_order_decision"](system_modal, 1000000, true) == "system-layer", "trusted system window uses its reserved layer")
assert(window_manager["z_order_decision"](system_modal, 1000000, false) == "deny-origin-mismatch", "app cannot self-assert system window identity")
assert(window_manager["focus_decision"](system_modal, 0, false) == "deny-origin-mismatch", "focus policy requires authenticated system origin")
assert(window_manager["resize_decision"]("tiling", false, 640, 480) == "deny-layout-owned", "tiler owns geometry without an override")
assert(window_manager["resize_decision"]("tiling", true, 640, 480) == "allow-policy-only", "valid override permits a tiled resize request")
assert(window_manager["transition_valid"]("floating", "maximized"), "known window modes can transition")
assert(not window_manager["transition_valid"]("floating", "unmanaged"), "unknown window mode is rejected")
make four_tile_metrics := window_manager["tile_metrics"](3, 4, 1920, 1080, 8)
assert(four_tile_metrics[0] == "grid" and four_tile_metrics[1] == 2 and four_tile_metrics[2] == 2, "four windows use a deterministic two-by-two grid")
assert(window_manager["tile_metrics"](0, 16, 320, 200, 8)[0] == "deny-display-too-small", "tile layout rejects cells below the minimum size")
assert(window_manager["tile_metrics"](0, 4, 1920, 1080, 8)[3] == quotient(1920 - 3 * 8, 2), "tile cell width uses whole pixels")
assert(not window_manager["stacking_order_valid"]([1, 2, 0]), "stacking order rejects invalid window identifiers")

make running_app := ["reaper-studio", 42, 0, true, true, false, 2, false]
make hidden_system_app := ["kernel-worker", 1, 0, false, true, true, 1, false]
assert(taskbar["entry_valid"](running_app), "taskbar entry is valid")
assert(taskbar["visibility"](running_app) == "visible", "running user app is visible")
assert(taskbar["visibility"](hidden_system_app) == "hidden-system", "system task is hidden from the user taskbar")
assert(taskbar["window_count"]("reaper-studio", ["reaper-studio", "mora", "reaper-studio"]) == 2, "windows group by application identity")
assert(taskbar["activation_decision"](running_app, 0) == "focus-running-app", "running application activation focuses its window group")
assert(taskbar["activation_decision"](["editor", 43, 1, true, true, false, 1, false], 0) == "switch-workspace-and-focus", "taskbar activation switches to the owning workspace")
assert(taskbar["activation_decision"](["pinned-tool", 44, 0, true, false, false, 0, false], 0) == "jora-compose-request", "pinned application produces a Jora composition request only")
assert(taskbar["attention_decision"](running_app) == "normal", "taskbar attention state is explicit")

make app_manifest := ["orgze", "1.0.0", "ivan-vhs", "sandbox-orgze", "installed", 67108864, 40, "disabled", ["fs.read", "workspace.read"]]
make app_grants := ["fs.read", "workspace.read"]
assert(desktop_sandbox["manifest_valid"](app_manifest), "desktop app manifest is valid")
assert(desktop_sandbox["capability_subset"](app_manifest[8], app_grants), "requested app capabilities are a subset of grants")
assert(desktop_sandbox["admission"](app_manifest, true, true, true, app_grants) == "admit-policy-only", "verified installed app passes policy admission")
assert(desktop_sandbox["admission"](app_manifest, false, true, true, app_grants) == "deny-unverified-catalog", "unverified catalog fails closed")
assert(desktop_sandbox["admission"](app_manifest, true, false, true, app_grants) == "deny-unverified-signature", "unverified package signature fails closed")
assert(desktop_sandbox["admission"](app_manifest, true, true, false, app_grants) == "deny-sandbox-unavailable", "missing sandbox broker fails closed")
assert(desktop_sandbox["admission"](app_manifest, true, true, true, ["fs.read"]) == "deny-capability-escalation", "app cannot amplify capabilities")
make network_manifest := ["browser", "1.0.0", "vendor", "sandbox-browser", "installed", 134217728, 60, "disabled", ["net.access"]]
assert(desktop_sandbox["admission"](network_manifest, true, true, true, ["net.access"]) == "deny-network-policy", "network access requires brokered mode")
assert(desktop_sandbox["permission_decision"]("camera.capture", app_grants, false) == "deny-ungranted", "ungranted permission is denied")
assert(desktop_sandbox["permission_decision"]("camera.capture", app_grants, true) == "approval-requires-broker-commit", "user approval alone does not mutate grants")
assert(desktop_sandbox["child_grants_valid"](app_grants, ["fs.read"]), "child capability set may be attenuated")
assert(not desktop_sandbox["capability_subset"]([17], app_grants), "non-text capability names are rejected")

make normal_notification := [7, 42, 2, 1000000, 30000000, "Build finished", "The native check completed.", false]
make forged_notification := [8, 42, 3, 1000000, 30000000, "System update", "Restart required.", true]
assert(notifications["descriptor_valid"](normal_notification), "notification descriptor is valid")
assert(not notifications["descriptor_valid"]([7, 42, 2, 1000000, 30000000, 5, "bad title", false]), "wrongly typed notification text is rejected")
assert(notifications["admission"](normal_notification, false, true) == "admit-policy-only", "user notification requires the granted notification capability")
assert(notifications["admission"](forged_notification, false, true) == "deny-system-spoof", "application cannot spoof a system notification")
assert(notifications["layer"](forged_notification, false) == "deny-origin-mismatch", "spoofed system notification cannot enter a trusted layer")
make trusted_notification := [9, 1, 3, 1000000, 30000000, "System update", "Restart required.", true]
assert(notifications["admission"](trusted_notification, true, true) == "admit-policy-only", "authenticated system notification passes admission")
assert(notifications["layer"](trusted_notification, true) == "system-reserved", "authenticated system notification uses its reserved layer")
assert(notifications["expired"](normal_notification, 31000000), "notification expires after its declared TTL")
assert(not notifications["expired"](normal_notification, 2000000), "notification remains visible inside its TTL")
assert(notifications["queue_decision"](8, 8) == "backpressure", "full notification queue reports backpressure")
assert(notifications["queue_decision"]("8", 8) == "invalid", "malformed notification queue counters are rejected")

make active_session := ["session-1", "user-1", "active", 0, 4, 1000000, false]
assert(session["descriptor_valid"](active_session), "desktop session descriptor is valid")
assert(not session["descriptor_valid"](["session-2", "user-1", "active", 0, 4, 1000000, true]), "contradictory locked-session state is rejected")
assert(session["transition_valid"]("active", "locked"), "active session may be locked")
assert(not session["transition_valid"]("ended", "active"), "ended session cannot be revived")
assert(session["switch_workspace_decision"](active_session, 2, true) == "switch-policy-only", "authorized user can switch workspaces")
assert(session["switch_workspace_decision"](active_session, 2, false) == "deny-capability", "workspace switching requires authorization")
assert(session["switch_workspace_decision"](active_session, 4, true) == "deny-invalid-workspace", "out-of-range workspace is rejected")
assert(session["restore_decision"](true, false, true, 4) == "migration-required", "unknown session schema requires migration")
assert(session["restore_decision"](true, true, false, 4) == "deny-user-mismatch", "session restore cannot cross user boundaries")

assert(theme["palette_color"]("canvas") == "#050505", "desktop canvas uses the noir base")
assert(theme["palette_color"]("accent") == "#FFD700", "brand accent uses semantic gold")
assert(theme["status_color"]("success") == "#22C55E", "success uses the status green")
assert(theme["status_color"]("error") == "#EF4444", "error uses the status red")
assert(theme["status_color"]("info") == "#3B82F6", "information uses the status blue")
assert(theme["token_allowed"]("accent", "#FFD700"), "approved semantic accent is accepted")
assert(not theme["token_allowed"]("accent", "#00FF00"), "arbitrary application accent is rejected")
assert(not theme["token_allowed"]("unknown-role", "#FFFFFF"), "unknown theme roles are rejected")
assert(theme["theme_mode_valid"]("high-contrast"), "high-contrast theme mode is supported")
assert(not theme["text_pair_valid"]("text-primary", "accent"), "brand accent is not a default text background")

assert(workspace["layout_mode_valid"]("tiling"), "tiling layout mode is supported")
assert(not workspace["layout_mode_valid"]("unbounded"), "unknown layout mode is rejected")
assert(workspace["panel_visible"]("inspector", ["navigation", "inspector"]), "enabled workspace panel is visible")
assert(not workspace["panel_visible"]("debug", ["navigation", "inspector"]), "undeclared workspace panel stays hidden")

make bridge_window_event := [1, 1, 9001, 77, 0, "window.focus", 192, 1700000000]
assert(native_bridge["event_valid"](bridge_window_event), "native bridge accepts a bounded version 1 event")
assert(native_bridge["route_decision"](bridge_window_event, false, ["ui.window.manage"]) == "route-window-manager-policy", "window events route through Reaper window policy")
assert(native_bridge["route_decision"](bridge_window_event, false, []) == "deny-capability", "native bridge rejects missing window capability")

make bridge_workspace_event := [1, 1, 9010, 77, 0, "workspace.switch", 96, 1700000004]
assert(native_bridge["route_decision"](bridge_workspace_event, false, ["ui.workspace.switch"]) == "route-session-policy", "workspace events route through session policy")

make bridge_launcher_event := [1, 1, 9011, 77, 0, "launcher.resolve", 256, 1700000005]
assert(native_bridge["route_decision"](bridge_launcher_event, false, ["ui.app.resolve"]) == "route-app-admission-policy", "launcher requests route through app admission policy")

make bridge_theme_event := [1, 1, 9012, 77, 0, "theme.resolve", 64, 1700000006]
assert(native_bridge["route_decision"](bridge_theme_event, false, ["ui.theme.read"]) == "route-theme-policy", "theme lookups route through semantic token policy")

make bridge_settings_event := [1, 1, 9013, 77, 0, "settings.validate", 128, 1700000007]
assert(native_bridge["route_decision"](bridge_settings_event, false, ["ui.settings.validate"]) == "route-config-policy", "settings validation routes through Reaper config policy")

assert(not native_bridge["next_sequence"](8, 10), "native bridge rejects sequence gaps")
assert(native_bridge["next_sequence"](8, 9), "native bridge accepts the next event sequence")

make bridge_system_notice := [1, 2, 9002, 1, 0, "system.notification.post", 128, 1700000001]
assert(native_bridge["route_decision"](bridge_system_notice, false, ["ui.notification.system"]) == "deny-system-origin", "apps cannot forge system notifications")
assert(native_bridge["route_decision"](bridge_system_notice, true, ["ui.notification.system"]) == "route-notification-policy", "authenticated system notifications reach notification policy")

make bridge_oversized := [1, 3, 9003, 77, 0, "launcher.resolve", 65537, 1700000002]
assert(not native_bridge["event_valid"](bridge_oversized), "native bridge rejects oversized payloads")

make bridge_unknown := [1, 4, 9004, 77, 0, "shell.execute", 8, 1700000003]
assert(not native_bridge["event_valid"](bridge_unknown), "native bridge rejects unknown operations")

emit "DUCKOS_REAPER_CONTRACTS_OK"

# DAK application catalog, aliases, request admission and lifecycle.
import "applications/runtime.rpr" as applications
import "applications/domain_contracts.rpr" as application_domains
import "applications/workflows.rpr" as application_workflows

assert(applications["catalog_valid"](), "the reconciled DAK application catalog contains 45 unique descriptors")
assert(size(applications["app_catalog"]()) == 45, "all confirmed DAK application descriptors are registered")
assert(applications["resolve_app_id"]("ka-bon") == "kabon", "legacy Ka-bon package ID resolves to the Mora catalog ID")
assert(applications["resolve_app_id"]("dak.kabon") == "kabon", "base-suite Ka-bon package ID resolves to the Mora catalog ID")
assert(applications["resolve_app_id"]("dak.orriganize") == "orriganize", "ORGze keeps its established package identity")
assert(applications["find_app"]("orriganize")[1] == "ORGze", "ORGze display name is canonical")
assert(applications["resolve_app_id"]("not-a-dak-app") == "", "unknown application IDs are rejected")

make poi_grants := ["capture.entries.read", "capture.entries.write"]
make poi_create := ["req-poi-1", "poi", "create", "capture.entries.write", 64, "local-capture", true]
make poi_delete_without_consent := ["req-poi-2", "poi", "delete", "capture.entries.write", 64, "local-capture", false]
make poi_missing_grant := ["req-poi-3", "poi", "create", "capture.entries.write", 64, "local-capture", true]
assert(applications["request_decision"](poi_create, poi_grants) == "admit-policy-only", "a declared local operation with a grant is admitted to policy only")
assert(applications["request_decision"](poi_delete_without_consent, poi_grants) == "deny-user-consent", "destructive app operations require explicit consent")
assert(applications["request_decision"](poi_missing_grant, []) == "deny-capability", "an app cannot use an undelegated capability")

make wrong_scope := ["req-poi-4", "poi", "create", "capture.entries.write", 64, "host-userland", true]
make wrong_operation := ["req-poi-5", "poi", "launch", "capture.entries.write", 64, "local-capture", true]
make oversized_request := ["req-poi-6", "poi", "create", "capture.entries.write", 65537, "local-capture", true]
assert(applications["request_decision"](wrong_scope, poi_grants) == "deny-scope", "app requests cannot escape their declared data scope")
assert(applications["request_decision"](wrong_operation, poi_grants) == "deny-unsupported-operation", "unregistered app operations are rejected")
assert(applications["request_decision"](oversized_request, poi_grants) == "deny-invalid-request", "oversized inline IPC payloads are rejected")

make local_event := ["event-1", "poi", "orriganize", "capture-to-project", 128, true, "idem-event-1", 1]
make unconsented_event := ["event-2", "poi", "orriganize", "capture-to-project", 128, false, "idem-event-2", 1]
make unknown_endpoint_event := ["event-3", "poi", "unknown-target", "capture-to-project", 128, true, "idem-event-3", 1]
assert(applications["integration_event_valid"](local_event), "versioned app integration event with consent and idempotency is valid")
assert(not applications["integration_event_valid"](unconsented_event), "cross-app events require explicit user consent")
assert(not applications["integration_event_valid"](unknown_endpoint_event), "cross-app events require registered endpoints")
assert(applications["lifecycle_transition_valid"]("created", "ready"), "new application can become ready")
assert(applications["lifecycle_transition_valid"]("running", "stopping"), "running application can stop gracefully")
assert(not applications["lifecycle_transition_valid"]("stopped", "running"), "stopped application cannot be revived by an invalid transition")
assert(applications["app_open_decision"]("dak.files", "ready") == "allow-user-space-open", "registered ready app can be opened in user space")
assert(applications["app_open_decision"]("security", "disabled") == "deny-disabled", "disabled app cannot be opened")
emit "DAK_APPLICATION_RUNTIME_V1:PASS"

# App-specific payload contracts: every catalog identity has a bounded record shape.
assert(application_domains["payload_valid"]("dak.settings", [4, 16, "user", false]), "Settings accepts a bounded user preference")
assert(application_domains["payload_valid"]("dak.files", ["read", 2, 128, true, false]), "Files accepts a bounded selected-file read")
assert(application_domains["payload_valid"]("dak.calendar", ["create", 1700000000, 1700003600, 5, false]), "Calendar accepts a bounded event")
assert(application_domains["payload_valid"]("dak.clock", ["alarm", 1700000000, 5, false]), "Clock accepts a local alarm")
assert(application_domains["payload_valid"]("dak.notes", [1024, "private", false]), "Notes accepts a private note")
assert(application_domains["payload_valid"]("dak.tasks", [64, 1700000000, 2, false]), "Tasks accepts a bounded reminder")
assert(application_domains["payload_valid"]("dak.calculator", [32, 18]), "Calculator accepts a bounded expression")
assert(application_domains["payload_valid"]("dak.browser", [512, "ask", true, false]), "Browser accepts a permission-pending navigation")
assert(application_domains["payload_valid"]("dak.mail", [32, 2, 4096, true]), "Mail send requires explicit consent")
assert(application_domains["payload_valid"]("dak.contacts", ["create", 64, "local", false]), "Contacts accepts a local contact")
assert(application_domains["payload_valid"]("dak.gallery", [3, 1048576, true, false]), "Gallery requires a user-selected media source")
assert(application_domains["payload_valid"]("dak.media", ["play", true, false, false]), "Media player accepts local playback")
assert(application_domains["payload_valid"]("dak.editor", ["read", true, 4096, false]), "Editor accepts a selected document")
assert(application_domains["payload_valid"]("dak.system-tools", ["inspect", 2, "processes.read", false]), "System tools remain non-privileged")
assert(application_domains["payload_valid"]("dak.software-center", ["install-request", 32, 16, true]), "Software Center installation is an explicit request")

assert(application_domains["payload_valid"]("cockos", [48000, 2, 24, 512, true]), "Cockos recording requires visible consent")
assert(application_domains["payload_valid"]("kavun", ["media-1", 1000000, "private", true, false]), "Kavun keeps private media scope")
assert(application_domains["payload_valid"]("ka-bon", ["receipt-1", 1250, "USD", "food", true]), "Ka-bon validates confirmed expense data")
assert(application_domains["payload_valid"]("gloverty", ["rule-1", "manual", "create-task", "local", true, true]), "Gloverty requires consent for enabled automation")
assert(application_domains["payload_valid"]("po", [512, "normal", "ask", false]), "Po models per-site permission state")
assert(application_domains["payload_valid"]("illidia", ["game-1", 64, 128, true, false]), "Illidia validates user-authorized game action")
assert(application_domains["payload_valid"]("unify", ["phone-1", 64, "paired", true, false]), "Unify requires an authenticated pairing state")
assert(application_domains["payload_valid"]("sestem", ["kernel", "experimental", "source-ledger", 1700000000]), "Sestem reports evidence-backed status")
assert(application_domains["payload_valid"]("setupup", ["dark", "ru", true, true]), "SetupUP accepts an explicit locale and theme")
assert(application_domains["payload_valid"]("orriganize", ["list-1", 64, 3, "open", false]), "ORGze validates a local project list")
assert(application_domains["payload_valid"]("abriganza", [64, 1024, 10, 2, false]), "Abriganza remains metadata-only")
assert(application_domains["payload_valid"]("olaab", ["album-1", 64, 20, "local-index"]), "Olaab validates a local collection")
assert(application_domains["payload_valid"]("concrete-thump", [120, 58, 4, 16]), "Concrete Thump validates rhythm profile bounds")
assert(application_domains["payload_valid"]("seu-beu", [true, true, true, true, true]), "Seu-Beu requires all review confirmations")
assert(application_domains["payload_valid"]("love-il", ["entry-1", 2048, 1700000000, "local-private"]), "Love-IL keeps journal entries local")
assert(application_domains["payload_valid"]("poi", ["capture-1", 512, 1700000000]), "Poi validates a bounded capture")
assert(application_domains["payload_valid"]("poi-2", ["card-1", 64, 1024, "local-reference"]), "Poi-2 validates a local knowledge card")
assert(application_domains["payload_valid"]("po-2", ["route-1", 4, true, false]), "Po-2 is a manually ordered route without GPS")
assert(application_domains["payload_valid"]("gamecharager", ["game-1", 64, 512, "metadata-only", false]), "GameCharager never launches an executable")
assert(application_domains["payload_valid"]("exedotexe", ["pe", 2048, 512, 64, true]), "EXEdotEXE inspects read-only executable metadata")

assert(application_domains["payload_valid"]("red-sparrow", ["project-1", 4, 1048576, true]), "Red Sparrow keeps its creative project local")
assert(application_domains["payload_valid"]("mora-ai", [1024, 4096, "local", true, "bounded-session"]), "Mora AI accepts a bounded local session")
assert(application_domains["payload_valid"]("security", ["finding-1", 2, 1024, "request-only"]), "Sentinel emits request-only remediation")
assert(application_domains["payload_valid"]("updates", ["snapshot-1", 1048576, true, true]), "Restore requires a verified snapshot and explicit consent")
assert(application_domains["payload_valid"]("runtime", ["compat-1", "pe32+", "DABI64", true, false]), "Bridge remains isolated and does not auto-execute")
assert(application_domains["payload_valid"]("workspace", ["workspace-1", 4, "local", false]), "Control validates a local workspace")
assert(application_domains["payload_valid"]("provenance", ["sha256", 64, 1024, true]), "Proof validates a SHA-256 evidence record")
assert(application_domains["payload_valid"]("mora-boost", ["profile-1", "balanced", 60, false]), "Mora Boost profile does not directly alter hardware")
assert(application_domains["payload_valid"]("desktop", ["audit", "session", "current-user", false, true]), "DAK Desktop audit stays in the current-user scope")
assert(application_domains["payload_valid"]("mora-commons", [12, 20, "all"]), "Mora Commons query is bounded")

assert(not application_domains["payload_valid"]("cockos", [48000, 2, 24, 512, false]), "Cockos rejects recording without consent")
assert(not application_domains["payload_valid"]("abriganza", [64, 1024, 10, 2, true]), "Abriganza cannot turn inspection into archive extraction")
assert(not application_domains["payload_valid"]("po-2", ["route-1", 4, true, true]), "Po-2 cannot enable GPS tracking")
assert(not application_domains["payload_valid"]("exedotexe", ["pe", 2048, 512, 64, false]), "EXEdotEXE cannot authorize executable launch")
assert(not application_domains["payload_valid"]("runtime", ["compat-1", "pe32+", "DABI64", true, true]), "Bridge cannot implicitly execute a compatibility target")
emit "DAK_APPLICATION_DOMAIN_CONTRACTS_V1:PASS"

# Registered inter-app workflows preserve endpoints, action identity, bounds and consent.
assert(application_workflows["workflow_catalog_valid"](), "all nine specified application workflows are unique and bounded")
assert(size(application_workflows["workflow_catalog"]()) == 9, "all nine specified app-to-app workflows are registered")

make budget_event := ["budget-1", "gloverty", "kabon", "prepare_weekly_budget_summary", 1024, true, "budget-idem-1", 1]
make event_memory := ["memory-1", "cockos", "kavun", "add_to_event_slice", 4096, true, "memory-idem-1", 1]
make browser_transfer := ["tabs-1", "po", "unify", "transfer_tabs_to_paired_device", 2048, true, "tabs-idem-1", 1]
make clip_transfer := ["clip-1", "illidia", "unify", "transfer_clip_to_paired_device", 8192, true, "clip-idem-1", 1]
make capture_to_orgze := ["capture-1", "poi", "orriganize", "add_capture_to_project_list", 512, true, "capture-idem-1", 1]
make album_to_kavun := ["album-1", "olaab", "kavun", "open_selected_media_collection", 256, true, "album-idem-1", 1]
make capture_to_card := ["card-1", "poi", "poi-2", "create_knowledge_card_from_selected_text", 1024, true, "card-idem-1", 1]
make game_to_inspector := ["game-inspect-1", "gamecharager", "exedotexe", "request_read_only_executable_inspection", 512, true, "game-idem-1", 1]
make rhythm_to_audio := ["rhythm-1", "concrete-thump", "cockos", "hand_off_bpm_and_swing_metadata", 128, true, "rhythm-idem-1", 1]

assert(application_workflows["workflow_event_valid"]("automation.weekly-budget-summary.v1", budget_event), "Gloverty to Ka-bon workflow is valid")
assert(application_workflows["workflow_event_valid"]("media.event-memory-assembly.v1", event_memory), "Cockos to Kavun workflow is valid")
assert(application_workflows["workflow_event_valid"]("continuity.browser-tabs.v1", browser_transfer), "Po to Unify workflow is valid")
assert(application_workflows["workflow_event_valid"]("continuity.game-clips.v1", clip_transfer), "Illidia to Unify workflow is valid")
assert(application_workflows["workflow_event_valid"]("planning.poi-to-orriganize.v1", capture_to_orgze), "Poi to ORGze workflow is valid")
assert(application_workflows["workflow_event_valid"]("media.olaab-to-kavun.v1", album_to_kavun), "Olaab to Kavun workflow is valid")
assert(application_workflows["workflow_event_valid"]("knowledge.poi-to-poi-2.v1", capture_to_card), "Poi to Poi-2 workflow is valid")
assert(application_workflows["workflow_event_valid"]("gaming.gamecharager-to-exedotexe.v1", game_to_inspector), "GameCharager to EXEdotEXE workflow is valid")
assert(application_workflows["workflow_event_valid"]("audio.concrete-thump-to-cockos.v1", rhythm_to_audio), "Concrete Thump to Cockos workflow is valid")

make unconsented_budget := ["budget-2", "gloverty", "kabon", "prepare_weekly_budget_summary", 1024, false, "budget-idem-2", 1]
make misrouted_budget := ["budget-3", "gloverty", "unify", "prepare_weekly_budget_summary", 1024, true, "budget-idem-3", 1]
make oversized_budget := ["budget-4", "gloverty", "kabon", "prepare_weekly_budget_summary", 8192, true, "budget-idem-4", 1]
assert(not application_workflows["workflow_event_valid"]("automation.weekly-budget-summary.v1", unconsented_budget), "workflow rejects missing consent")
assert(not application_workflows["workflow_event_valid"]("automation.weekly-budget-summary.v1", misrouted_budget), "workflow rejects an unexpected recipient")
assert(not application_workflows["workflow_event_valid"]("automation.weekly-budget-summary.v1", oversized_budget), "workflow rejects payloads above its bound")
assert(not application_workflows["workflow_event_valid"]("unknown.workflow.v1", budget_event), "unknown workflow IDs are rejected")
emit "DAK_APPLICATION_WORKFLOWS_V1:PASS"
