+		previous := d.builder.traceStrategy
+		d.builder.bavForwarder = forwarder
+		d.builder.setTraceStrategy(func(event tracer.Event) {
+			if previous != nil {
+				previous(event)
+			}
+			forwarder.Enqueue(event)
+		})
+	}
+
+	return d.builder.build(), nil
 
 }
 

diff --git a/internal/builder/bav_event_forwarder.go b/internal/builder/bav_event_forwarder.go
new file mode 100644
--- /dev/null
+++ b/internal/builder/bav_event_forwarder.go
@@ -0,0 +1,172 @@
+package builder
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"runtime"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/beelzebub-labs/beelzebub/v3/internal/parser"
+	"github.com/beelzebub-labs/beelzebub/v3/internal/tracer"
+	log "github.com/sirupsen/logrus"
+)
+
+const (
+	bavQueueCapacity = 128
+	bavMaxEventBytes = 1 << 20
+)
+
+type bavEventForwarder struct {
+	endpoint string
+	token string
+	client *http.Client
+	queue chan []byte
+	ctx context.Context
+	cancel context.CancelFunc
+	done chan struct{}
+	closeOnce sync.Once
+	dropped atomic.Uint64
+}
+
+func newBAVEventForwarder(config parser.BeelzebubAVTracing) (*bavEventForwarder, error) {
+	if !config.Enabled { return nil, nil }
+	parsed, err := url.Parse(config.Endpoint)
+	if err != nil || parsed == nil || parsed.Scheme != "http" || parsed.User != nil ||
+		parsed.RawQuery != "" || parsed.Fragment != "" || parsed.Path != "/v1/events" {
+		return nil, errors.New("BAV endpoint must be an HTTP loopback URL ending in /v1/events")
+	}
+	host := strings.ToLower(parsed.Hostname())
+	ip := net.ParseIP(host)
+	if ip == nil || !ip.IsLoopback() {
+		return nil, errors.New("BAV endpoint must resolve to a loopback host")
+	}
+	token := strings.TrimSpace(config.AuthToken)
+	if config.AuthTokenFile != "" {
+		info, statErr := os.Lstat(config.AuthTokenFile)
+		if statErr != nil { return nil, fmt.Errorf("stat BAV token file: %w", statErr) }
+		if info.Mode()&os.ModeSymlink != 0 || !info.Mode().IsRegular() {
+			return nil, errors.New("BAV token path must be a regular non-symlink file")
+		}
+		if info.Size() > 4096 { return nil, errors.New("BAV token file exceeds 4096 bytes") }
+		if info.Mode().Perm()&0o077 != 0 && runtime.GOOS != "windows" {
+			return nil, errors.New("BAV token file permissions must be 0600 or stricter")
+		}
+		data, readErr := os.ReadFile(config.AuthTokenFile)
+		if readErr != nil { return nil, fmt.Errorf("read BAV token file: %w", readErr) }
+		token = strings.TrimSpace(string(data))
+	}
+	if len(token) < 32 || len(token) > 4096 || strings.ContainsAny(token, "\r\n\x00") {
+		return nil, errors.New("BAV auth token must contain 32–4096 bytes without control characters")
+	}
+	timeout := time.Duration(config.TimeoutMilliseconds) * time.Millisecond
+	if config.TimeoutMilliseconds == 0 { timeout = 750 * time.Millisecond }
+	if timeout < 100*time.Millisecond || timeout > 5*time.Second {
+		return nil, errors.New("BAV timeout must be between 100 and 5000 milliseconds")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	transport := &http.Transport{
+		Proxy: nil,
+		DialContext: (&net.Dialer{Timeout: timeout, KeepAlive: 30*time.Second}).DialContext,
+		ResponseHeaderTimeout: timeout,
+		MaxIdleConns: 2, MaxIdleConnsPerHost: 1, IdleConnTimeout: 15*time.Second,
+	}
+	forwarder := &bavEventForwarder{
+		endpoint: config.Endpoint, token: token,
+		client: &http.Client{
+			Transport: transport, Timeout: timeout,
+			CheckRedirect: func(_ *http.Request, _ []*http.Request) error {
+				return errors.New("BAV event forwarder does not follow redirects")
+			},
+		},
+		queue: make(chan []byte, bavQueueCapacity), ctx: ctx, cancel: cancel, done: make(chan struct{}),
+	}
+	go forwarder.run()
+	return forwarder, nil
+}
+
+// Enqueue never blocks the honeypot tracer workers. On saturation the event is
+// dropped and only a counter is logged; event contents and credentials are not logged.
+func (f *bavEventForwarder) Enqueue(event tracer.Event) {
+	if f == nil || f.ctx.Err() != nil { return }
+	payload, err := json.Marshal(event)
+	if err != nil || len(payload) > bavMaxEventBytes {
+		f.dropped.Add(1)
+		return
+	}
+	select {
+	case f.queue <- payload:
+	default:
+		count := f.dropped.Add(1)
+		if count == 1 || count%100 == 0 { log.WithField("dropped_events", count).Warn("BAV event queue is full") }
+	}
+}
+
+func (f *bavEventForwarder) run() {
+	defer close(f.done)
+	for {
+		select {
+		case <-f.ctx.Done():
+			return
+		case payload := <-f.queue:
+			f.deliver(payload)
+		}
+	}
+}
+
+func (f *bavEventForwarder) deliver(payload []byte) {
+	for attempt := 0; attempt < 2; attempt++ {
+		ctx, cancel := context.WithTimeout(f.ctx, f.client.Timeout)
+		request, err := http.NewRequestWithContext(ctx, http.MethodPost, f.endpoint, bytes.NewReader(payload))
+		if err == nil {
+			request.Header.Set("Content-Type", "application/json")
+			request.Header.Set("Authorization", "Bearer "+f.token)
+			var response *http.Response
+			response, err = f.client.Do(request)
+			if err == nil {
+				_, _ = io.Copy(io.Discard, io.LimitReader(response.Body, 1024))
+				status := response.StatusCode
+				_ = response.Body.Close()
+				cancel()
+				if status == http.StatusAccepted { return }
+				if status >= 400 && status < 500 && status != http.StatusTooManyRequests {
+					f.dropped.Add(1)
+					log.WithField("http_status", status).Warn("BAV rejected a honeypot event")
+					return
+				}
+			}
+		}
+		cancel()
+		if attempt == 0 {
+			timer := time.NewTimer(100 * time.Millisecond)
+			select {
+			case <-f.ctx.Done():
+				timer.Stop()
+				return
+			case <-timer.C:
+			}
+		}
+	}
+	count := f.dropped.Add(1)
+	if count == 1 || count%100 == 0 { log.WithField("dropped_events", count).Warn("BAV event delivery failed") }
+}
+
+func (f *bavEventForwarder) Close() {
+	if f == nil { return }
+	f.closeOnce.Do(f.cancel)
+	select {
+	case <-f.done:
+	case <-time.After(2 * time.Second):
+	}
+	f.client.CloseIdleConnections()
+}

diff --git a/internal/builder/bav_event_forwarder_test.go b/internal/builder/bav_event_forwarder_test.go
