+++ b/internal/builder/bav_event_forwarder_test.go
@@ -0,0 +1,60 @@
+package builder
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/beelzebub-labs/beelzebub/v3/internal/parser"
+	"github.com/beelzebub-labs/beelzebub/v3/internal/tracer"
+	"github.com/stretchr/testify/require"
+)
+
+func TestBAVForwarderPostsEventToLoopbackReceiver(t *testing.T) {
+	received := make(chan tracer.Event, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("Authorization") != "Bearer 0123456789abcdef0123456789abcdef" || r.Header.Get("Content-Type") != "application/json" {
+			http.Error(w, "invalid request headers", http.StatusUnauthorized)
+			return
+		}
+		var event tracer.Event
+		if err := json.NewDecoder(r.Body).Decode(&event); err != nil {
+			http.Error(w, "invalid event JSON", http.StatusBadRequest)
+			return
+		}
+		received <- event
+		w.WriteHeader(http.StatusAccepted)
+	}))
+	defer server.Close()
+
+	forwarder, err := newBAVEventForwarder(parser.BeelzebubAVTracing{
+		Enabled: true, Endpoint: server.URL + "/v1/events",
+		AuthToken: "0123456789abcdef0123456789abcdef", TimeoutMilliseconds: 500,
+	})
+	require.NoError(t, err)
+	require.NotNil(t, forwarder)
+	forwarder.Enqueue(tracer.Event{Protocol: "SSH", User: "root", Password: "synthetic"})
+	select {
+	case event := <-received:
+		require.Equal(t, "SSH", event.Protocol)
+		require.Equal(t, "synthetic", event.Password)
+	case <-time.After(time.Second):
+		t.Fatal("timed out waiting for BAV event")
+	}
+	forwarder.Close()
+}
+
+func TestBAVForwarderRejectsNonLoopbackAndWeakToken(t *testing.T) {
+	_, err := newBAVEventForwarder(parser.BeelzebubAVTracing{
+		Enabled: true, Endpoint: "http://192.0.2.10:9777/v1/events",
+		AuthToken: "0123456789abcdef0123456789abcdef",
+	})
+	require.Error(t, err)
+	_, err = newBAVEventForwarder(parser.BeelzebubAVTracing{
+		Enabled: true, Endpoint: "http://127.0.0.1:9777/v1/events",
+		AuthToken: "weak",
+	})
+	require.Error(t, err)
+}

