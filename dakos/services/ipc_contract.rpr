# Bounded IPC message and mailbox admission contracts for Dak.
# This source validates metadata only; it does not send messages or allocate buffers.

craft valid_ipc_message(message) {
    when size(message) != 5 { yield false }
    when message[0] == "" or message[1] == "" { yield false }
    when message[2] < 0 or message[2] > 65536 { yield false }
    when message[3] < 0 or message[3] > 7 { yield false }
    when message[4] < 0 or message[4] > 15 { yield false }
    yield true
}

craft mailbox_admits(queue_depth, queue_capacity, payload_bytes, payload_limit, total_bytes, total_limit) {
    yield queue_depth >= 0 and queue_capacity > 0 and queue_depth < queue_capacity and payload_bytes >= 0 and payload_bytes <= payload_limit and total_bytes >= 0 and total_bytes + payload_bytes <= total_limit
}

make valid_message := ["desktop", "compositor", 4096, 3, 0]
make oversized_message := ["desktop", "compositor", 65537, 3, 0]
make invalid_priority := ["audio", "mixer", 128, 8, 0]

assert(valid_ipc_message(valid_message), "valid IPC metadata must pass")
assert(not valid_ipc_message(oversized_message), "oversized IPC payload must fail")
assert(not valid_ipc_message(invalid_priority), "priority outside the scheduler range must fail")
assert(mailbox_admits(3, 8, 4096, 65536, 8192, 32768), "mailbox with remaining capacity must admit")
assert(not mailbox_admits(8, 8, 128, 65536, 0, 32768), "full mailbox must reject")
assert(not mailbox_admits(1, 8, 70000, 65536, 0, 32768), "payload over the message limit must reject")
assert(not mailbox_admits(1, 8, 1024, 65536, 32000, 32768), "aggregate memory limit must reject")

emit "DAK_REAPER_IPC_CONTRACT:PASS"
