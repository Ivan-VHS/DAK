# DAKOS boot contract.
# Phases are ordered; a native boot backend must preserve this sequence.

export craft expected_phases() {
    yield ["reset", "firmware", "memory", "interrupts", "scheduler", "ipc", "drivers", "services", "desktop"]
}

export craft transition_valid(current, next) {
    make transitions := [
        ["reset", "firmware"],
        ["firmware", "memory"],
        ["memory", "interrupts"],
        ["interrupts", "scheduler"],
        ["scheduler", "ipc"],
        ["ipc", "drivers"],
        ["drivers", "services"],
        ["services", "desktop"]
    ]
    vary valid := false
    each pair in transitions {
        when pair[0] == current and pair[1] == next {
            change valid := true
        }
    }
    yield valid
}

export craft sequence_valid(phases) {
    yield phases == expected_phases()
}

export craft failure_action(exit_code) {
    when exit_code == 0 {
        yield "continue"
    } otherwise {
        yield "recovery"
    }
}
