# DuckOS — Reaper Edition.
# Run: python -m reaper duckos.rpr

import "kernel/system.rpr" as system
import "kernel/process.rpr" as process
import "kernel/memory.rpr" as memory
import "kernel/security.rpr" as security
import "kernel/vfs.rpr" as vfs
import "kernel/devices.rpr" as devices
import "kernel/monitor.rpr" as monitor
import "kernel/services.rpr" as services
import "kernel/catalog.rpr" as catalog

make boot := system["boot_report"]()
emit boot[0] ++ " " ++ boot[1] ++ " — " ++ boot[2]

make process_table := [
    process["create"](1, "init", 100, "ready", 4096),
    process["create"](2, "device-manager", 80, "ready", 8192),
    process["create"](3, "event-loop", 60, "sleeping", 2048)
]
assert(process["all_valid"](process_table), "process table validation failed")

make ready := process["schedule"](process_table)
make next := process["next_process"](process_table)
emit "Processes: " ++ text(size(process_table))
emit "Ready queue: " ++ text(size(ready))
emit "Next process: " ++ next[1]

make heap := memory["create_pool"](1048576, 262144)
make heap_after_start := memory["allocate"](heap, 65536)
assert(memory["is_valid"](heap_after_start), "memory accounting failed")
emit "Memory free: " ++ text(memory["available"](heap_after_start)) ++ " bytes"
emit "Memory pressure: " ++ memory["pressure"](heap_after_start)

make granted := ["process.read", "memory.read", "device.inspect"]
make requested := ["process.read", "device.inspect"]
assert(security["allows_all"](granted, requested), "capability check failed")
emit "Security policy: deny by default"

make virtual_path := vfs["join"]("/system", "config/duckos.json")
assert(vfs["is_safe"](virtual_path), "virtual path validation failed")
assert(vfs["stays_under"]("/system", virtual_path), "path escaped system root")
emit "Virtual path: " ++ virtual_path

make device_table := [
    devices["create"](1, "console", "terminal", "online", "1.0"),
    devices["create"](2, "memory", "ram", "online", "1.0"),
    devices["create"](3, "network", "adapter", "offline", "unknown")
]
assert(devices["all_valid"](device_table), "device table validation failed")
emit "Online devices: " ++ text(devices["online_count"](device_table))

make health := monitor["health_snapshot"](24, 41, 36)
emit "System health: " ++ health[3]

make services_table := [
    services["start"](services["create_service"]("device-manager", "stopped", 0)),
    services["start"](services["create_service"]("event-loop", "stopped", 0))
]
make event_queue := services["push_event"]([], "system.boot", "ready", 1)
emit "Running services: " ++ text(services["running_count"](services_table))
emit "Queued events: " ++ text(services["event_count"](event_queue))
emit "Function registry target: " ++ text(catalog["target_count"]())

make boot_record := [
    boot,
    ["processes", size(process_table), "ready", size(ready)],
    ["memory", memory["capacity"](heap_after_start), memory["used"](heap_after_start)],
    ["devices", size(device_table), devices["online_count"](device_table)],
    ["health", health[3]],
    ["services", services["running_count"](services_table)],
    ["catalogue_target", catalog["target_count"]()]
]
write_json("var/boot-report.json", boot_record)

emit "DuckOS boot checks passed."
