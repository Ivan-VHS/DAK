{
  "schema": "dak.gui-neuro-profile.v1",
  "version": 1,
  "repository": "Ivan-VHS/DAK",
  "ui_stack": [
    "Reaper policy contracts (.rpr)",
    "Qt 6 Widgets host-native desktop",
    "JSON design tokens"
  ],
  "primary_ui_surfaces": [
    "duckos/ui/desktop.rpr",
    "duckos/ui/accessibility.rpr",
    "duckos/ui/theme.rpr",
    "duckos/graphics/compositor.rpr",
    "mora/native/main.cpp",
    "mora/theme.json",
    "tests/test_desktop.py"
  ],
  "automation": {
    "agent_mode": "supervised-neuro-agent",
    "stages": [
      "observe",
      "measure",
      "diagnose",
      "propose",
      "sandbox",
      "validate",
      "feature-branch",
      "human-review"
    ],
    "target_branch_policy": "feature-branch-only",
    "human_review_required": true,
    "allow_main_branch_writes": false,
    "allow_auto_merge": false,
    "model_runtime": "operator-configured; not invoked by this workflow",
    "change_budget": {
      "max_files_per_pr": 20,
      "prefer_small_reviewable_changes": true,
      "require_rollback_plan": true
    }
  },
  "privacy": {
    "external_model_data": "deny_by_default",
    "telemetry": "disabled",
    "secret_access": "deny",
    "local_artifacts_only": true
  },
  "allowed_write_paths": [
    "gui-neuro-profile.v1.json",
    "docs/GUI_NEURO_AUTOIMPROVEMENT.md",
    "tools/validate_gui_neuro_profile.mjs",
    ".github/workflows/gui-neuro-profile.yml",
    "duckos/ui/",
    "duckos/graphics/",
    "mora/native/",
    "mora/theme.json",
    "tests/"
  ],
  "protected_write_paths": [
    "boot/",
    "kernel/",
    "drivers/",
    "security/",
    "duckos/kernel/",
    "duckos/drivers/",
    "duckos/security/",
    "desktop/demo/"
  ],
  "quality_gates": [
    "Reaper policy checks for .rpr changes",
    "Qt 6 native desktop build and offscreen smoke test",
    "Desktop unit tests",
    "Contrast, focus visibility, keyboard traversal and high-DPI review"
  ],
  "success_metrics": [
    "keyboard reachability of all native actions",
    "visible focus state under all supported themes",
    "no regression in host-window lifecycle",
    "no new kernel or privileged behavior from UI-only changes"
  ],
  "implementation_boundary": "DAK is a Reaper-first OS project. The Qt application is a host-native desktop and must not be described as a kernel compositor. The browser demo is reference-only. System policy and UI contracts belong in Reaper .rpr where applicable; do not introduce Python implementations or Python test scaffolds for DAK OS functionality."
}
