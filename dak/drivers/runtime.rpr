# DAK Driver Runtime v1 — admission, resource and safe-unload policy.
# No PCI/USB enumeration, module mapping, IRQ routing, MMIO or DMA occurs here.

import "abi.rpr" as abi
import "orchestrator.rpr" as orchestrator
import "../platform/targets.rpr" as targets

# Driver: [id, abi, bus, architecture, capabilities, publisher, digest, signature_state, payload_bytes].
export craft descriptor_valid(driver) {
    when kind(driver) != "list" or size(driver) != 9 {
        yield false
    }
    when kind(driver[0]) != "text" or kind(driver[1]) != "number" or kind(driver[2]) != "text" or kind(driver[3]) != "text" {
        yield false
    }
    when kind(driver[4]) != "list" or kind(driver[5]) != "text" or kind(driver[6]) != "text" or kind(driver[7]) != "text" or kind(driver[8]) != "number" {
        yield false
    }
    when driver[0] == "" or driver[1] <= 0 or driver[2] == "" {
        yield false
    }
    when not targets["architecture_known"](driver[3]) {
        yield false
    }
    when size(driver[4]) > 64 or driver[5] == "" or driver[6] == "" {
        yield false
    }
    when driver[7] != "verified" and driver[7] != "unverified" and driver[7] != "revoked" {
        yield false
    }
    when driver[8] <= 0 or driver[8] > 268435456 {
        yield false
    }
    yield true
}

# Device follows DuckDriver's six-field resource descriptor.
export craft resource_admission(device, registered_devices) {
    when kind(registered_devices) != "list" or not orchestrator["device_valid"](device) {
        yield "reject-invalid-device"
    }
    each registered in registered_devices {
        when orchestrator["resources_conflict"](device, registered) {
            yield "reject-resource-conflict"
        }
    }
    yield "resource-plan-only"
}

# Resource reservation is part of admission, never an optional caller-side check.
export craft admission(driver, device, registered_devices, target_arch, expected_abi, supported_buses, grants) {
    when kind(target_arch) != "text" or kind(expected_abi) != "number" or kind(supported_buses) != "list" or kind(grants) != "list" {
        yield "reject-descriptor"
    }
    when not descriptor_valid(driver) or not orchestrator["device_valid"](device) {
        yield "reject-descriptor"
    }
    when resource_admission(device, registered_devices) != "resource-plan-only" {
        yield "reject-resource-conflict"
    }
    when driver[7] == "revoked" {
        yield "reject-revoked"
    }
    when driver[7] != "verified" {
        yield "reject-signature"
    }
    when driver[5] == "" or driver[6] == "" {
        yield "reject-provenance"
    }
    when driver[3] != target_arch {
        yield "reject-architecture"
    }
    when driver[2] != device[1] {
        yield "reject-device-match"
    }

    make request := [driver[0], driver[1], driver[2], driver[4]]
    when abi["load_policy"](request, expected_abi, supported_buses, grants) != "descriptor-approved" {
        yield "reject-capability-or-abi"
    }
    yield "admit-isolated-plan-only"
}

# candidate -> verified -> admitted -> mapped -> initialized -> running.
# stopping/stopped is a separate, quiesced shutdown path.
export craft transition_valid(current, next) {
    when current == "candidate" and next == "verified" {
        yield true
    }
    when current == "verified" and next == "admitted" {
        yield true
    }
    when current == "admitted" and next == "mapped" {
        yield true
    }
    when current == "mapped" and next == "initialized" {
        yield true
    }
    when current == "initialized" and next == "running" {
        yield true
    }
    when current == "running" and next == "stopping" {
        yield true
    }
    when current == "stopping" and next == "stopped" {
        yield true
    }
    when current == "candidate" and next == "rejected" {
        yield true
    }
    when (current == "verified" or current == "admitted" or current == "mapped" or current == "initialized") and next == "failed" {
        yield true
    }
    yield false
}

export craft unload_policy(state, irqs_quiesced, dma_stopped, device_quiesced) {
    when kind(irqs_quiesced) != "boolean" or kind(dma_stopped) != "boolean" or kind(device_quiesced) != "boolean" {
        yield "reject-state"
    }
    when state != "running" and state != "stopping" {
        yield "reject-state"
    }
    when not irqs_quiesced {
        yield "reject-irq-active"
    }
    when not dma_stopped {
        yield "reject-dma-active"
    }
    when not device_quiesced {
        yield "reject-device-active"
    }
    yield "unload-plan-only"
}
