# DAK Driver Core descriptor and resource-conflict policy.
# Descriptors are metadata only; this module never installs or starts a driver.

import "abi.rpr" as abi
import "../kernel/memory.rpr" as memory

# Device: [id, bus, resource_base, resource_bytes, irq, irq_exclusive].
export craft device_valid(device) {
    when kind(device) != "list" or size(device) != 6 {
        yield false
    }
    when kind(device[0]) != "text" or kind(device[1]) != "text" or kind(device[2]) != "number" or kind(device[3]) != "number" or kind(device[4]) != "number" {
        yield false
    }
    when device[0] == "" or device[1] == "" or device[2] % 1 != 0 or device[3] % 1 != 0 or device[4] % 1 != 0 or device[2] < 0 or device[3] <= 0 or device[4] < 0 {
        yield false
    }
    when kind(device[5]) != "boolean" {
        yield false
    }
    yield true
}

export craft resources_conflict(left, right) {
    when not device_valid(left) or not device_valid(right) {
        yield true
    }

    when left[0] == right[0] {
        yield true
    }
    when memory["ranges_overlap"](left[2], left[3], right[2], right[3]) {
        yield true
    }
    when left[4] == right[4] and (left[5] or right[5]) {
        yield true
    }
    yield false
}

# Package: [driver_id, abi_version, bus, target_arch, required_capabilities, signature_valid].
export craft package_policy(package, device, target_arch, expected_abi, supported_buses, grants) {
    when size(package) != 6 or not device_valid(device) {
        yield "reject"
    }
    when package[0] == "" or package[5] != true {
        yield "reject"
    }
    when package[2] != device[1] or package[3] != target_arch {
        yield "reject"
    }

    make descriptor := [package[0], package[1], package[2], package[4]]
    when abi["load_policy"](descriptor, expected_abi, supported_buses, grants) != "descriptor-approved" {
        yield "reject"
    }
    yield "approved"
}
