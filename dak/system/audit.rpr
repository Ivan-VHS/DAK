# DAK System Audit v1 — bounded append-only journal policy.
# This module validates record shape and append intent; durable storage and
# authenticated hash computation are supplied by a trusted provider.

# Record: [sequence, request_id, actor, action, resource, outcome, reason,
#          previous_digest, digest].
export craft record_valid(record) {
    when size(record) != 9 {
        yield false
    }
    when record[0] <= 0 {
        yield false
    }
    when record[1] == "" or record[2] == "" or record[3] == "" {
        yield false
    }
    when record[4] == "" or record[5] == "" or record[6] == "" {
        yield false
    }
    when record[7] == "" or record[8] == "" {
        yield false
    }
    yield true
}

export craft chain_valid(records) {
    vary expected_sequence := 1
    vary previous_digest := "genesis"
    each record in records {
        when not record_valid(record) {
            yield false
        }
        when record[0] != expected_sequence or record[7] != previous_digest {
            yield false
        }
        change previous_digest := record[8]
        change expected_sequence := expected_sequence + 1
    }
    yield true
}

export craft append_policy(records, record, max_records) {
    when max_records <= 0 or size(records) >= max_records {
        yield "reject-capacity"
    }
    when not chain_valid(records) or not record_valid(record) {
        yield "reject-invalid-record"
    }

    vary expected_sequence := 1
    vary previous_digest := "genesis"
    each previous in records {
        change expected_sequence := previous[0] + 1
        change previous_digest := previous[8]
    }
    when record[0] != expected_sequence {
        yield "reject-sequence"
    }
    when record[7] != previous_digest {
        yield "reject-chain-link"
    }
    yield "append-plan-only"
}
