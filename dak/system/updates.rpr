# DAK Update System v1 — signed-manifest, anti-rollback and A/B policy.
# It does not download payloads, write slots, edit boot entries or reboot the machine.

import "../platform/targets.rpr" as targets

# Manifest: [channel, major, minor, patch, architecture, sequence,
#            payload_bytes, digest, publisher, signature_state].
export craft manifest_valid(manifest) {
    when size(manifest) != 10 {
        yield false
    }
    when manifest[0] == "" or manifest[1] < 0 or manifest[2] < 0 or manifest[3] < 0 {
        yield false
    }
    when not targets["architecture_known"](manifest[4]) {
        yield false
    }
    when manifest[5] <= 0 or manifest[6] <= 0 or manifest[6] > 4294967296 {
        yield false
    }
    when manifest[7] == "" or manifest[8] == "" {
        yield false
    }
    when manifest[9] != "verified" and manifest[9] != "unverified" and manifest[9] != "revoked" {
        yield false
    }
    yield true
}

export craft version_newer(candidate, current) {
    when size(candidate) != 3 or size(current) != 3 {
        yield false
    }
    when candidate[0] < 0 or candidate[1] < 0 or candidate[2] < 0 {
        yield false
    }
    when current[0] < 0 or current[1] < 0 or current[2] < 0 {
        yield false
    }
    when candidate[0] > current[0] {
        yield true
    }
    when candidate[0] < current[0] {
        yield false
    }
    when candidate[1] > current[1] {
        yield true
    }
    when candidate[1] < current[1] {
        yield false
    }
    yield candidate[2] > current[2]
}

export craft admission(manifest, target_arch, current_version, current_sequence) {
    when not manifest_valid(manifest) {
        yield "reject-manifest"
    }
    when manifest[9] == "revoked" {
        yield "reject-revoked"
    }
    when manifest[9] != "verified" {
        yield "reject-signature"
    }
    when manifest[4] != target_arch {
        yield "reject-architecture"
    }
    when manifest[5] <= current_sequence {
        yield "reject-sequence-rollback"
    }
    when not version_newer([manifest[1], manifest[2], manifest[3]], current_version) {
        yield "reject-downgrade"
    }
    yield "stage-inactive-slot-plan-only"
}

export craft inactive_slot(active_slot) {
    when active_slot == "A" {
        yield "B"
    }
    when active_slot == "B" {
        yield "A"
    }
    yield ""
}

# Boot control must target only the inactive slot and require healthy evidence.
export craft activation_policy(active_slot, target_slot, boot_health) {
    make expected_slot := inactive_slot(active_slot)
    when expected_slot == "" {
        yield "reject-active-slot"
    }
    when target_slot != expected_slot {
        yield "reject-slot-target"
    }
    when boot_health != "healthy" {
        yield "reject-boot-unhealthy"
    }
    yield "activate-plan-only"
}

# idle -> verified -> staged -> armed -> boot_pending -> confirmed.
# boot_pending can only return to a previous slot through rollback.
export craft transition_valid(current, next) {
    when current == "idle" and next == "verified" {
        yield true
    }
    when current == "verified" and next == "staged" {
        yield true
    }
    when current == "staged" and next == "armed" {
        yield true
    }
    when current == "armed" and next == "boot_pending" {
        yield true
    }
    when current == "boot_pending" and next == "confirmed" {
        yield true
    }
    when current == "boot_pending" and next == "rolling_back" {
        yield true
    }
    when current == "rolling_back" and next == "rolled_back" {
        yield true
    }
    when current == "confirmed" and next == "idle" {
        yield true
    }
    yield false
}

export craft boot_result_policy(health, attempts, max_attempts) {
    when attempts < 0 or max_attempts <= 0 or attempts > max_attempts {
        yield "reject-attempt-count"
    }
    when health == "healthy" {
        yield "confirm-plan-only"
    }
    when health == "pending" {
        yield "await-confirmation"
    }
    when health == "failed" and attempts >= max_attempts {
        yield "rollback-plan-only"
    }
    when health == "failed" {
        yield "retry-plan-only"
    }
    yield "reject-health-state"
}
